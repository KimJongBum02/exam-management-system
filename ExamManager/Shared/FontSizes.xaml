<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── 글자 크기 ──
         교수 화면과 학생 시험 운영 화면의 모든 글자가 이 값을 쓴다(큰 제목과 아이콘은 제외).
         한꺼번에 키우거나 줄일 때는 여기만 고친다. 두 앱이 같은 파일을 나눠 쓰므로 값이 어긋날 일이 없다.
         강의실 현황판은 창에 맞춰 스스로 늘어나므로 따로 둔다. -->
    <sys:Double x:Key="FontTiny">13</sys:Double>     <!-- 화면 모니터링 썸네일 위 작은 글자 -->
    <sys:Double x:Key="FontMini">14</sys:Double>     <!-- 메뉴 잠김 표시·배지·한 줄 오류 -->
    <sys:Double x:Key="FontSmall">15</sys:Double>    <!-- 라벨·캡션·표 머리글·체크박스 -->
    <sys:Double x:Key="FontBody">16</sys:Double>     <!-- 본문·버튼·입력칸·표 칸 -->
    <sys:Double x:Key="FontStrong">17</sys:Double>   <!-- 마법사 단계 이름·퀴즈 문제 번호 -->
    <sys:Double x:Key="FontSection">18</sys:Double>  <!-- 구역 제목·퀴즈 탭 -->
    <sys:Double x:Key="FontLarge">19</sys:Double>    <!-- 왼쪽 메뉴·상단 '교수용'·'학생용' -->
    <sys:Double x:Key="FontXLarge">21</sys:Double>   <!-- 학생 칸 이름·OX 보기 -->
    <sys:Double x:Key="FontKpi">30</sys:Double>      <!-- KPI 큰 숫자 -->

</ResourceDictionary>
