<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="View\LoginView\Assets\JB.jpg" />
    <None Remove="View\LoginView\Assets\loginbackground.png" />
    <None Remove="View\LoginView\Assets\yuhan.png" />
    <None Remove="View\LoginView\Assets\로그인배경.png" />
    <None Remove="View\LoginView\Assets\유한대학교 로고.png" />
    <None Remove="View\LoginView\Assets\유한대학교로고.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="View\LoginView\Assets\loginbackground.png" />
    <Resource Include="View\LoginView\Assets\yuhan.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\NetworkInterop\NetworkInterop.cs" Link="NetworkInterop.cs" />
  </ItemGroup>
  <!-- NetworkLib_Native.dll 자동 복사 (Debug/Release 구성에 맞게 자동 선택) -->
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NetworkLib_Native.dll</Link>
    </None>
  </ItemGroup>

</Project>
