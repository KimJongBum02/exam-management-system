<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="View\LoginView\Assets\JB.jpg" />
    <None Remove="View\LoginView\Assets\loginbackground.png" />
    <None Remove="View\LoginView\Assets\yuhan.png" />
    <None Remove="View\LoginView\Assets\로그인배경.png" />
    <None Remove="View\LoginView\Assets\유한대학교 로고.png" />
    <None Remove="View\LoginView\Assets\유한대학교로고.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="View\LoginView\Assets\loginbackground.png" />
    <Resource Include="View\LoginView\Assets\yuhan.png" />
  </ItemGroup>
  <!-- 두 UI가 공유하는 글꼴 (ExamManager\Fonts) -->
  <ItemGroup>
    <Resource Include="..\Fonts\NEXON Lv2 Gothic.ttf" Link="Fonts\NEXON Lv2 Gothic.ttf" />
    <Resource Include="..\Fonts\NEXON Lv2 Gothic Bold.ttf" Link="Fonts\NEXON Lv2 Gothic Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\NetworkInterop\NetworkInterop.cs" Link="NetworkInterop.cs" />
  </ItemGroup>
  <!-- NetworkLib_Native.dll 자동 복사 (Debug/Release 구성에 맞게 자동 선택) -->
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NetworkLib_Native.dll</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\NetworkControl.dll"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\NetworkControl.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NetworkControl.dll</Link>
    </None>
  </ItemGroup>
  <!-- 압축 해제용 FileControl.dll + 7za.exe 복사 -->
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\FileControl.dll"
          Condition="Exists('$(SolutionDir)x64\$(Configuration)\FileControl.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FileControl.dll</Link>
    </None>
    <None Include="$(SolutionDir)7za.exe" Condition="Exists('$(SolutionDir)7za.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>7za.exe</Link>
    </None>
  </ItemGroup>

</Project>
