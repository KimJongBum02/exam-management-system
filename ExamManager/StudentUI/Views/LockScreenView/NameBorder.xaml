<UserControl x:Class="StudentUI.Views.LockScreenView.NameBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.Views.LockScreenView"
             mc:Ignorable="d">

    
    <Border Background="White"
            CornerRadius="12"
            Padding="14,14,18,14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05"
                              BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 이름 + 학번 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Student.StudentName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1A1A2E"/>
                <TextBlock Text="{Binding Student.StudentNumber}"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 로그아웃 버튼 -->
            <Button Grid.Column="1"
        VerticalAlignment="Center"
        Cursor="Hand"
        BorderThickness="0"
        Click="LogoutButton_Click">
                
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LogoutBorder"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="→"
                                                       FontSize="12"
                                                       Foreground="#888888"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="로그아웃"
                                                       FontSize="12"
                                                       Foreground="#888888"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LogoutBorder" Property="Background" Value="#F4F4F8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="LogoutBorder" Property="Background" Value="#E8E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>