<UserControl x:Class="StudentUI.View.StudentExamView.StudentExamState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
             mc:Ignorable="d">
    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.04"
                              BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 내용이 남은 공간 차지 -->
                <RowDefinition Height="Auto"/>
                <!-- 버튼은 아래 고정 -->
            </Grid.RowDefinitions>

            <!-- 시험 응시 -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📝" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="문제 풀이 및 답안 작성" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,14">
                    <StackPanel>

                        <!-- 압축 해제 폴더 라벨 -->
                        <TextBlock Text="내 작업 폴더 (문제 및 답안 파일)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,8"/>

                        <!-- 파일 경로 입력창 + 폴더 버튼 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <TextBlock x:Name="SelectedFileName"
                                           Text="{Binding ExamFile.ExtractFolder, TargetNullValue=문제 파일이 아직 준비되지 않았습니다.}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12"
                                           Foreground="#1E293B"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Button Grid.Column="2"
                                    x:Name="SelectFileButton"
                                    Command="{Binding OpenExtractFolderCommand}"
                                    ToolTip="작업 폴더 열기"
                                    Height="40"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="FolderBorder"
                                                            Background="#1A56DB"
                                                            CornerRadius="8"
                                                            Padding="12,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="폴더 열기" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FolderBorder" Property="Background" Value="#1D4ED8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="FolderBorder" Property="Background" Value="#1E40AF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- 진행 상태 영역 -->
                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText"
                                               Grid.Column="0"
                                               Text="{Binding ExamFile.StatusText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1E293B"/>
                                    <TextBlock x:Name="ProgressText"
                                               Grid.Column="1"
                                               Text="{Binding ExamFile.Progress, StringFormat={}{0}%}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#1A56DB"/>
                                </Grid>

                                <!-- 프로그레스 바 -->
                                <ProgressBar x:Name="FileProgressBar"
                                             Height="6"
                                             Value="{Binding ExamFile.Progress, Mode=OneWay}"
                                             Maximum="100"
                                             Margin="0,0,0,8">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Border Background="#E2E8F0" CornerRadius="3">
                                                            <Border x:Name="PART_Track">
                                                                <Border x:Name="PART_Indicator"
                                                                        Background="#1A56DB"
                                                                        CornerRadius="3"
                                                                        HorizontalAlignment="Left"/>
                                                            </Border>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <TextBlock x:Name="CurrentFileText"
                                           Text="{Binding ExamFile.FileName, StringFormat=현재 파일: {0}}"
                                           FontSize="11"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- 시험종료 버튼 -->
            <Button Grid.Row="1"
                    x:Name="ExamEndButton"
                    Command="{Binding SubmitAnswerCommand}"
                    Content="시험 종료"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#EF4444"
                    Cursor="Hand"
                    Padding="0,12">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="EndBorder" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EndBorder" Property="Background" Value="#FEE2E2"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="EndBorder" Property="Background" Value="#FECACA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
