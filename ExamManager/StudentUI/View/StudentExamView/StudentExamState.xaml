<UserControl x:Class="StudentUI.View.StudentExamView.StudentExamState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
             mc:Ignorable="d">
    <Border Background="White"
        CornerRadius="12"
        Padding="16"
        Margin="6,0,0,0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05"
                          BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 내용이 남은 공간 차지 -->
                <RowDefinition Height="Auto"/>
                <!-- 버튼은 아래 고정 -->
            </Grid.RowDefinitions>

            <!-- 시험 응시 -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="시험 응시" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                </StackPanel>

            <Separator Background="#F0F0F0"/>
            </StackPanel>
            <Border Background="#F8F9FA"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,10"
        Margin="0,0,0,10">
                <StackPanel>

                    <!-- 압축 해제 폴더 라벨 -->
                    <TextBlock Text="압축 해제 폴더"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#1A1A2E"
                   Margin="0,0,0,8"/>

                    <!-- 파일 경로 입력창 + 폴더 버튼 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                            <TextBlock x:Name="SelectedFileName"
                           Text="{Binding ExamFile.ExtractFolder}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12"
                           Foreground="#1A1A2E"/>
                        </Border>

                        <Button Grid.Column="2"
                    x:Name="SelectFileButton"
                    Command="{Binding OpenExtractFolderCommand}"
                    ToolTip="압축 해제 폴더 열기"
                    Width="44" Height="44"
                    Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="FolderBorder"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                                    <TextBlock Text="🗀"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#1A1A2E"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="FolderBorder" Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 진행 상태 영역 -->
                    <Border Background="#F0F2FF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="{Binding ExamFile.StatusText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"/>
                                <TextBlock x:Name="ProgressText"
                               Grid.Column="1"
                               Text="{Binding ExamFile.Progress, StringFormat={}{0}%}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#5C6AC4"/>
                            </Grid>

                            <!-- 프로그레스 바 -->
                            <ProgressBar x:Name="FileProgressBar"
                             Height="6"
                             Value="{Binding ExamFile.Progress, Mode=OneWay}"
                             Maximum="100"
                             Margin="0,0,0,8">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="#D0D4F0" CornerRadius="3">
                                                        <Border x:Name="PART_Track">
                                                            <Border x:Name="PART_Indicator"
                                                        Background="#5C6AC4"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Left"/>
                                                        </Border>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <TextBlock x:Name="CurrentFileText"
                           Text="{Binding ExamFile.FileName, StringFormat=현재 파일: {0}}"
                           FontSize="11"
                           Foreground="#8888AA"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
            <!-- 시험종료 버튼 -->
            <Button Grid.Row="1"
                x:Name="ExamEndButton"
                Content="시험 종료"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#A32D2D"
                Cursor="Hand"
                Padding="0,12">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="EndBorder" Background="#FCEBEB" BorderBrush="#F09595" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EndBorder" Property="Background" Value="#F9D6D6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="EndBorder" Property="Background" Value="#F5C0C0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
