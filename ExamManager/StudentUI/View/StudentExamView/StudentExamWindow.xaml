<Window x:Class="StudentUI.View.StudentExamView.StudentExamWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
      mc:Ignorable="d" 
      Background="#F5F5F5"
      FontFamily="{StaticResource AppFont}"
      Title="StudentExamWindow" Height="750" Width="1300">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- 학생 정보 -->
            <local:StudentInformation Margin="0,0,0,12"/>
            <!-- 시험 타이머-->
            <local:StudentTimer Margin="0,0,0,12"/>
            <!-- 파일 수신 및 시험 응시-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:StudentFile Grid.Column="0" VerticalAlignment="Stretch"/>
                <local:StudentExamState Grid.Column="2" VerticalAlignment="Stretch"/>
            </Grid>

            <!-- 교수 PC 시험 흐름 연결 전까지 화면 전환 확인용 임시 버튼 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Command="{Binding GoToWaitingCommand}" Content="시험 대기 화면으로 전환"
                        Background="#E0E0E0" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12"/>
                <Button Command="{Binding GoToStartedCommand}" Content="시험 시작 화면으로 전환"
                        Background="#E0E0E0" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
