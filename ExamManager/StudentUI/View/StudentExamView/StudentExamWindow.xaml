<Window x:Class="StudentUI.View.StudentExamView.StudentExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
        xmlns:shared="clr-namespace:ExamManager.Shared"
        mc:Ignorable="d"
        Background="White"
        Title="시험 운영 - 학생용">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 글자 크기(FontBody 등)는 교수 앱과 한 벌을 나눠 쓴다 (ExamManager\Shared\FontSizes.xaml).
                 한꺼번에 키우거나 줄일 때는 그 파일만 고치면 두 앱이 함께 바뀐다 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StudentUI;component/FontSizes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 상단 네비게이션 버튼 스타일 -->
            <Style x:Key="TopNavButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 사이드바 메뉴 버튼 스타일 -->
            <Style x:Key="SidebarMenuButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- 1. 상단 네비게이션 헤더 -->
            <RowDefinition Height="*"/>  <!-- 2. 본문 -->
        </Grid.RowDefinitions>

        <!-- 1. 상단 네비게이션 헤더 — 왼쪽 제목 · 가운데 중요 공지 · 오른쪽 메뉴. 공지는 창 한가운데에 놓인다(HeaderBarPanel) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <shared:HeaderBarPanel Margin="24,0">
                <!-- 좌측: 로고 및 타이틀 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="학생용" FontSize="{StaticResource FontLarge}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 가운데: 교수가 등록한 중요 공지(답안 파일 이름 형식 등). 교수가 내릴 때까지 계속 보인다.
                     길면 … 으로 줄이고, 마우스를 올리면 전체가 보인다. 색은 교수 앱 상단의 중요 공지와 같다 -->
                <Border VerticalAlignment="Center" CornerRadius="17" Padding="16,6" BorderThickness="1"
                        Background="#FFFBEB" BorderBrush="#FCD34D"
                        ToolTip="{Binding ChatVM.ImportantNotice}"
                        Visibility="{Binding ChatVM.HasImportantNotice, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="📢 중요 공지" FontSize="{StaticResource FontSmall}" FontWeight="Bold"
                                   Foreground="#B45309" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChatVM.ImportantNotice}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="#78350F" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- 우측 메뉴 — 본문 제목 옆에 있던 '마지막 갱신'과 연결 상태를 여기로 당겨 왔다.
                     연결 상태는 글자로 한 번만 보인다(예전의 '연결 완료' 표시는 같은 말이라 뺐다) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime, StringFormat=마지막 갱신: {0}}"
                               FontSize="{StaticResource FontSmall}" Foreground="#94A3B8" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- 글자 영역과 버튼 영역을 가르는 선 -->
                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="16,0"/>

                    <!-- 알림 버튼 -->
                    <Button Style="{StaticResource TopNavButton}" Command="{Binding ToggleNotificationCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="알림" VerticalAlignment="Center"/>
                            <!-- 알림창을 열어 보면 사라진다. 전체 경고 수는 알림창 머리에 남는다 -->
                            <Border Background="#EF4444" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"
                                    Visibility="{Binding HasUnreadCheatWarnings, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadCheatWarningCount}" FontSize="{StaticResource FontTiny}" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- 채팅 버튼 -->
                    <Button x:Name="ChatButton" Style="{StaticResource TopNavButton}" Command="{Binding ToggleChatCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="채팅" VerticalAlignment="Center"/>
                            <Border Background="#2563EB" CornerRadius="9" Padding="6,1" Margin="7,0,0,0"
                                    Visibility="{Binding ChatVM.HasUnreadMessages, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ChatVM.UnreadCount}" FontSize="{StaticResource FontTiny}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- 프로필 -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center" Margin="6,0,0,0" Background="#F8FAFC">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Student.StudentName}" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBlock Text=" (" FontSize="{StaticResource FontBody}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Student.StudentNumber}" FontSize="{StaticResource FontBody}" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text=")" FontSize="{StaticResource FontBody}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Button Command="{Binding LogoutCommand}" Content="로그아웃" Background="Transparent" BorderThickness="0"
                                     Foreground="#EF4444" FontSize="{StaticResource FontSmall}" Cursor="Hand" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </shared:HeaderBarPanel>
        </Border>

        <!-- 2. 본문 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- 메인 콘텐츠 영역 -->
                <ColumnDefinition Width="Auto"/> <!-- 우측 드로어 -->
            </Grid.ColumnDefinitions>

            <!-- 메인 컨텐츠 영역 — 한 줄로 세워 화면 가운데에 둔다.
                 1920 화면에서 좌우로 너무 벌어지지 않도록 본문 폭을 MaxWidth 로 묶는다 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Margin="32,20,32,28">

                    <!-- 상단 타이틀 -->
                    <TextBlock Text="시험 진행 현황" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

                    <!-- 답안 제출 진행 상태 배너 -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                            Padding="16,12" Margin="0,12,0,0"
                            Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SubmitStatus}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                    </Border>

                    <!-- 시험 시간 — 화면에서 가장 먼저 눈에 들어와야 하는 값이라 가장 크게 둔다 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                            Padding="24,18" Margin="0,16,0,0">
                        <Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 전체 시간 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="전체 시간" FontSize="{StaticResource FontBody}" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ExamTime.TotalMinutes, FallbackValue=50}" FontSize="42" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="분" FontSize="{StaticResource FontSection}" Foreground="#64748B"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock Text="배정된 시험 시간" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Fill="#E2E8F0" Margin="0,6"/>

                                <!-- 남은 시간 -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="남은 시간" FontSize="{StaticResource FontBody}" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ExamTime.RemainingText, FallbackValue=00 : 00}"
                                               FontSize="44" FontWeight="Bold" Foreground="#1A56DB"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ExamTime.StatusText, FallbackValue=시험 대기 중}"
                                                   FontSize="{StaticResource FontSmall}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 시험 화면을 내려놓고 실습을 해도 남은 시간이 보이도록, 작은 창으로 따로 띄운다 -->
                            <Button x:Name="PipButton" Click="OnTogglePip"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="White" BorderThickness="0" Padding="8" Cursor="Hand"
                                    ToolTip="남은 시간을 항상 위에 뜨는 작은 창으로 보기">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </Button.Resources>
                                <Grid Width="18" Height="15">
                                    <Rectangle Stroke="#64748B" StrokeThickness="1.4" RadiusX="2.5" RadiusY="2.5"/>
                                    <Rectangle Fill="#64748B" Width="9" Height="7" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2.5,2.5"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 내 작업 폴더 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#E0E7FF" Margin="0,0,16,0">
                                <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="내 작업 폴더" FontSize="{StaticResource FontStrong}" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="(문제 및 답안 저장 경로)" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <!-- 전체 경로 대신 학생이 찾아가기 쉬운 이름으로 보인다 (바탕화면\시험 파일, 받은 뒤에는 그 아래 시험 폴더까지) -->
                                <TextBlock Text="{Binding DisplayFolderPath}"
                                           FontSize="{StaticResource FontBody}" Foreground="#475569" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <!-- 프로그레스 바 -->
                                <ProgressBar Height="6" Maximum="100" Value="{Binding ExamFile.Progress, Mode=OneWay}" Margin="0,8,16,0">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Border Background="#E2E8F0" CornerRadius="3">
                                                            <Border x:Name="PART_Track">
                                                                <Border x:Name="PART_Indicator" Background="#1A56DB" CornerRadius="3" HorizontalAlignment="Left"/>
                                                            </Border>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <!-- 막대가 다 찼을 때 무엇이 끝났는지 알 수 있게 한다 -->
                                <TextBlock Text="✓ 시험 파일 수신 완료" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" Foreground="#15803D"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ExamFile.IsReceived, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding OpenExtractFolderCommand}"
                                    Height="46" Padding="20,0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBd" Background="#1A56DB" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📂" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="작업 폴더 열기" FontSize="{StaticResource FontBody}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBd" Property="Background" Value="#1D4ED8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="btnBd" Property="Background" Value="#1E40AF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 시험 단계별 상세 현황 및 가이드 -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- 테이블/리스트 헤더 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14" CornerRadius="10,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <!-- 상태 칸은 폭을 고정한다. 글자 길이만큼 늘어나면 가운데 설명 칸이 눌려 줄이 한없이 길어진다 -->
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="항목" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="진행 내용 및 가이드" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="2" Text="현재 상태" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- 데이터 행 목록 -->
                            <ItemsControl ItemsSource="{Binding StatusItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 구분 및 아이콘 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="34" Height="34" Background="#F1F5F9" CornerRadius="8" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Category}" FontSize="{StaticResource FontBody}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- 상세 정보 및 안내 문구 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,20,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSmall}" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="22"/>
                                                </StackPanel>

                                                <!-- 상태 뱃지 (Badge) -->
                                                <Border Grid.Column="2" CornerRadius="14" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLevel}" Value="Success">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLevel}" Value="Info">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLevel}" Value="Warning">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSmall}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLevel}" Value="Success">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLevel}" Value="Info">
                                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLevel}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 마무리 안내와 주 버튼. 표 바로 아래에 붙인다 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"
                                   Text="💡 시험 진행 중에는 위 작업 폴더에서 소스 코드를 편집하고, 시험 종료 전 [답안 제출] 버튼을 눌러주세요."
                                   FontSize="{StaticResource FontBody}" Foreground="#64748B"/>

                        <!-- 주 액션 버튼: 모던 블랙 라운드 버튼 -->
                        <!-- 문제 폴더가 풀리기 전에는 낼 답안이 없어 누를 수 없다. 교수 화면처럼 짙은 회색으로 바꿔 알린다 -->
                        <Button Grid.Column="1" Command="{Binding SubmitAnswerCommand}"
                                Background="#18181B" Foreground="White" BorderThickness="0"
                                Padding="28,15" FontSize="{StaticResource FontSection}" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="답안 제출 및 시험 종료" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Background" Value="#5A626D"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 우측 오버레이 드로어 (알림 / 채팅 패널) -->
            <Border x:Name="SideDrawer" Grid.Column="1" Width="380" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotificationOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChatOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- 알림 패널 뷰 -->
                    <Grid Visibility="{Binding IsNotificationOpen, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 머리에 전체 경고 건수를 둔다 (시간 카드 옆에 있던 것을 옮겨 왔다) -->
                        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,16" Background="#FEF2F2">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="부정행위 감시 알림" FontSize="{StaticResource FontStrong}" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                    <Border Background="#B91C1C" CornerRadius="11" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSmall}" FontWeight="Bold" Foreground="White">
                                            <Run Text="{Binding CheatWarningCount, Mode=OneWay}"/><Run Text="건"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Command="{Binding ToggleNotificationCommand}" Content="✕"
                                        Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand"
                                        FontSize="{StaticResource FontBody}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock Text="새로운 알림이 없습니다." Foreground="#94A3B8" FontSize="{StaticResource FontBody}"
                                           HorizontalAlignment="Center" Margin="0,40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCheatWarnings}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding CheatWarnings}" Margin="14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- 긴 프로그램 이름이 시각 위로 겹치지 않도록 칸을 나눈다 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                                                   Foreground="#B91C1C" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"
                                                                   VerticalAlignment="Top" Margin="8,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock Text="시험 중에는 실행할 수 없는 프로그램입니다." FontSize="{StaticResource FontSmall}"
                                                               Foreground="#EF4444" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- 채팅 패널 뷰 -->
                    <Grid Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12" Background="White">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#EEF2FF" Margin="0,0,12,0">
                                        <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="교수님과 대화" FontSize="{StaticResource FontStrong}" FontWeight="Bold" Foreground="#0F172A"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#CBD5E1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="{StaticResource FontSmall}" Foreground="#64748B">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="연결 끊김"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="접속 중"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ToggleChatCommand}" Content="✕"
                                        Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand"
                                        FontSize="{StaticResource FontBody}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- 말풍선 목록. 새 말이 오면 맨 아래로 따라 내려간다(코드 비하인드) -->
                        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
                            <StackPanel Margin="14,16,14,16">
                                <!-- 날짜 구분선 -->
                                <Grid Margin="0,0,0,14">
                                    <Rectangle Height="1" Fill="#E2E8F0" VerticalAlignment="Center"/>
                                    <Border Background="#F8FAFC" Padding="10,0" HorizontalAlignment="Center">
                                        <TextBlock Text="오늘" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"/>
                                    </Border>
                                </Grid>

                                <!-- 안내 말풍선. 교수에게 무엇을 물어도 되는지 알려 준다 -->
                                <Border Background="#EEF2FF" CornerRadius="14" Padding="14,10" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="시험 대기 중에는 교수님께 자유롭게 질문할 수 있습니다."
                                               FontSize="{StaticResource FontSmall}" Foreground="#4338CA"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <!-- 교수가 보낸 말 — 왼쪽, 흰 말풍선. 같은 사람이 이어 말하면 이름과 얼굴을 다시 적지 않는다 -->
                                                <StackPanel x:Name="Theirs" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,40,0">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#E0E7FF"
                                                            VerticalAlignment="Bottom" Margin="0,0,8,0"
                                                            Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="교" FontSize="{StaticResource FontSmall}" FontWeight="Bold"
                                                                   Foreground="#4338CA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- 얼굴이 빠진 줄도 같은 자리에서 시작하도록 자리를 비워 둔다 -->
                                                    <Border Width="42">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSender}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="교수님" FontSize="{StaticResource FontSmall}" Foreground="#64748B" Margin="2,0,0,4"
                                                                   Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                    CornerRadius="14,14,14,4" Padding="14,10" MaxWidth="230">
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                           FontSize="{StaticResource FontBody}" Foreground="#1E293B" LineHeight="22"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayTime}" FontSize="{StaticResource FontTiny}" Foreground="#94A3B8"
                                                                       VerticalAlignment="Bottom" Margin="7,0,0,2"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 내가 보낸 말 — 오른쪽, 파란 말풍선 -->
                                                <StackPanel x:Name="Mine" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Margin="40,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="{StaticResource FontTiny}" Foreground="#94A3B8"
                                                               VerticalAlignment="Bottom" Margin="0,0,7,2"/>
                                                    <Border Background="#2563EB" CornerRadius="14,14,4,14" Padding="14,10" MaxWidth="230">
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                   FontSize="{StaticResource FontBody}" Foreground="White" LineHeight="22"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter TargetName="Theirs" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Mine" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 입력창 및 전송 -->
                        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,12" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="21" Padding="16,0" Height="42">
                                    <Grid>
                                        <TextBlock Text="메시지를 입력하세요" FontSize="{StaticResource FontBody}" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=ChatInput}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="ChatInput" Text="{Binding ChatVM.InputMessage, UpdateSourceTrigger=PropertyChanged}"
                                                 InputMethod.PreferredImeState="On" InputMethod.PreferredImeConversionMode="Native"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" FontSize="{StaticResource FontBody}" Foreground="#1E293B">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ChatVM.SendMessageCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1" Command="{Binding ChatVM.SendMessageCommand}" ToolTip="보내기"
                                        Background="#2563EB" Width="42" Height="42" Margin="10,0,0,0"
                                        Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="21"/>
                                        </Style>
                                    </Button.Resources>
                                    <!-- 종이비행기 -->
                                    <Path Fill="White" Margin="0,1,2,0"
                                          Data="M0,7 L18,0 L11,18 L8,10 Z"
                                          Stretch="Uniform" Width="17" Height="17"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- ═══════════════════════════════════════════════
             시험 종료 잠금 오버레이
             교수가 '시험 종료'를 누르면 IsExamEnded = true 가 되어 이 패널이 표시된다.
             Panel.ZIndex가 최상위라 아래 모든 요소를 완전히 가린다.
             IsHitTestVisible=True 이므로 오버레이 뒤에서의 클릭/키보드 입력이 불가능하다.
        ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Panel.ZIndex="9999"
              IsHitTestVisible="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExamEnded}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 반투명 어두운 배경 -->
            <Rectangle Fill="#CC0F172A"/>

            <!-- 중앙 카드 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1E293B" CornerRadius="20"
                    Padding="60,50" MinWidth="520"
                    BorderBrush="#334155" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">

                    <!-- 자물쇠 아이콘 원형 배경 -->
                    <Border Width="96" Height="96" CornerRadius="48"
                            Background="#EF4444" HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect Color="#EF4444" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="🔒" FontSize="42"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- 제목 -->
                    <TextBlock Text="시험이 종료되었습니다"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#F1F5F9"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- 구분선 -->
                    <Rectangle Height="1" Fill="#334155" Margin="0,0,0,20"/>

                    <!-- 안내 메시지. 제출 결과와 무관하게 늘 맞는 문구만 둔다 — 결과는 아래 상태 줄이 보여 준다 -->
                    <TextBlock Text="시험이 종료되었습니다. 더 이상 수정이 불가능합니다."
                               TextAlignment="Center" Foreground="#94A3B8"
                               FontSize="{StaticResource FontStrong}" LineHeight="24"
                               HorizontalAlignment="Center"/>

                    <!-- 답안 제출 상태 (제출 중 / 실패 이유 / 제출 완료) -->
                    <TextBlock Text="{Binding SubmitStatus}"
                               Visibility="{Binding HasSubmitStatus, Converter={StaticResource BoolToVis}}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Foreground="#F1F5F9" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>

                    <!-- 아직 답안을 내지 못했을 때만 보인다. 자동 수집이 실패했거나 앱을 다시 켠 경우 -->
                    <Button Content="{Binding SubmitAfterEndText}"
                            Command="{Binding SubmitAfterEndCommand}"
                            Visibility="{Binding CanSubmitAfterEnd, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,10"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"
                            FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 하단 구분선 -->
                    <Rectangle Height="1" Fill="#334155" Margin="0,24,0,20"/>

                    <!-- 시험 종료 시각 표시 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📋  " FontSize="{StaticResource FontBody}" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="시험 종료  " FontSize="{StaticResource FontBody}" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExamEndedTime, StringFormat='HH:mm:ss'}"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
