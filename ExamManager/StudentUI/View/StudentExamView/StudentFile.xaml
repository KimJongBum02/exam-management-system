<UserControl x:Class="StudentUI.View.StudentExamView.StudentFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
             mc:Ignorable="d">

    <Border Background="White"
        CornerRadius="12"
        Padding="16"
        Margin="0,0,6,0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05"
                          BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 내용이 남은 공간 차지 -->
                <RowDefinition Height="Auto"/>
                <!-- 버튼은 아래 고정 -->
            </Grid.RowDefinitions>

            <!-- 파일 수신 상태  -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="↓" FontSize="14" Foreground="#2E7D32"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="파일 수신 (준비)" FontSize="13" FontWeight="SemiBold"
                           Foreground="#2E7D32" VerticalAlignment="Center"/>
                </StackPanel>

              

                <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Padding="10,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EEEDFE" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="🔒" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="exam_files_encrypted.zip" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="수신 완료 · AES-256 암호화됨" FontSize="11"
                                   Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="✓" FontSize="12" Foreground="#2E7D32"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="시험 파일 수신 완료" FontSize="12" FontWeight="SemiBold"
                               Foreground="#2E7D32" VerticalAlignment="Center"/>
                </StackPanel>
                
            </StackPanel>

            <!-- 압축해제 버튼 -->
            <Button Grid.Row="1"
                x:Name="UnzipButton"
                Content="압축 해제"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Padding="0,12">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UnzipBorder"
                                        Background="#5B5BD6"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="UnzipBorder" Property="Background" Value="#4A4AC4"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="UnzipBorder" Property="Background" Value="#3A3AB4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
