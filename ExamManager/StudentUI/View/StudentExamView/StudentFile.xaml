<UserControl x:Class="StudentUI.View.StudentExamView.StudentFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.04"
                              BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 내용이 남은 공간 차지 -->
                <RowDefinition Height="Auto"/>
                <!-- 버튼은 아래 고정 -->
            </Grid.RowDefinitions>

            <!-- 파일 수신 상태  -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="↓" FontSize="14" Foreground="#1A56DB" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="파일 수신 (준비)" FontSize="14" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EFF6FF" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="🔒" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExamFile.FileName}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding ExamFile.StatusText}" FontSize="11"
                                       Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding ExamFile.IsReceived, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✓" FontSize="12" Foreground="#16A34A" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="시험 파일 수신 완료" FontSize="12" FontWeight="SemiBold"
                               Foreground="#16A34A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 압축 해제 결과 (해제 성공 시에만 표시) -->
                <StackPanel Visibility="{Binding ExamFile.IsExtracted, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="✓" FontSize="12" Foreground="#16A34A" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ExamFile.ExtractedFiles.Count, StringFormat=압축 해제 완료 · 파일 {0}개}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#16A34A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExamFile.ExtractedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="#475569"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                
            </StackPanel>

            <!-- 압축 해제 버튼은 제거했다.
                 교수가 시험 시작을 누르면 ExtractArchive 명령으로 자동 해제된다.
                 버튼을 남겨 두면 학생이 시험 시작 전에 문제를 미리 볼 수 있다. -->
        </Grid>
    </Border>
</UserControl>
