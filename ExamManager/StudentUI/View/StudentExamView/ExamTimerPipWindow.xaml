<Window x:Class="StudentUI.View.StudentExamView.ExamTimerPipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="남은 시간"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StudentUI;component/FontSizes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 편집기 위에 떠 있는 작은 시계. 끌어서 옮길 수 있다(코드 비하인드) -->
    <Border Background="#0F172A" CornerRadius="14" Padding="20,14" Margin="12"
            BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.35" ShadowDepth="3" BlurRadius="18"/>
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBlock Text="남은 시간" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="✕" Click="OnClose" HorizontalAlignment="Right" ToolTip="작은 창 닫기"
                        Background="Transparent" BorderThickness="0" Foreground="#64748B"
                        FontSize="{StaticResource FontSmall}" FontWeight="Bold" Cursor="Hand" Padding="6,0,0,0"/>
            </Grid>

            <TextBlock Text="{Binding RemainingText, FallbackValue=00 : 00}"
                       FontSize="34" FontWeight="Bold" Foreground="#F8FAFC"
                       FontFamily="Consolas, Segoe UI" Margin="0,4,0,2"/>

            <TextBlock Text="{Binding StatusText, FallbackValue=시험 대기 중}"
                       FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"/>
        </StackPanel>
    </Border>
</Window>
