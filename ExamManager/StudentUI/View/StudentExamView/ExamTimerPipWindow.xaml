<Window x:Class="StudentUI.View.StudentExamView.ExamTimerPipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
        Title="시험 운영 - 학생용" Icon="/Icon/Student.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StudentUI;component/FontSizes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 편집기 위에 떠 있는 작은 시계. 끌어서 옮길 수 있다(코드 비하인드).
         시험이 도는 동안에는 주 창이 숨어 이 창이 학생 앱의 유일한 모습이라 작업표시줄에 띄운다
         (감춰 두면 앱이 켜져 있는지 알 수 없고 작업표시줄 깜빡임도 묻힌다).
         제목·아이콘은 주 창과 같게 맞춰 단추 하나로 보인다. 자유 PIP 와 같은 이유다.

         닫기 단추는 두지 않는다. 시험을 봐야 하는 학생이 이 창을 닫을 이유가 없고,
         답안을 내면 어차피 사라진다. 잠시 치우는 것은 시험 화면 시간 카드의 작은 창 단추로 한다.

         폭을 320 으로 묶은 이유: 알림·채팅 칸을 펼칠 때 카드 폭이 바뀌면 오른쪽 위에 붙여 둔 창이
         화면 밖으로 밀려 나간다. 폭이 고정이면 아래로만 자란다(넘치는 것은 코드 비하인드가 끌어올린다).
         자유 PIP 와 같은 값이라 두 창이 같은 자리에서 같은 크기로 보인다. -->
    <Border Background="#0F172A" CornerRadius="14" Padding="20,14" Margin="12"
            BorderBrush="#334155" BorderThickness="1" Width="320">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.35" ShadowDepth="3" BlurRadius="18"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="남은 시간" FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding RemainingText, FallbackValue=00 : 00}"
                       FontSize="34" FontWeight="Bold" Foreground="#F8FAFC"
                       FontFamily="Consolas, Segoe UI" Margin="0,4,0,2" HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding StatusText, FallbackValue=시험 대기 중}"
                       FontSize="{StaticResource FontSmall}" Foreground="#94A3B8"
                       HorizontalAlignment="Center"/>

            <!-- 바탕화면에서 실습하다가 여기서 바로 답안을 낼 수 있게 하는 제출 버튼.
                 메인 시험 창의 것과 같은 명령(SubmitAnswerCommand)을 쓴다 — 코드 비하인드에서 연결

                 좌우는 카드 폭(320)이 정하므로 위아래 여백만 준다. 10 이던 것을 12 로 올린 것은
                 글자가 단추 테두리에 너무 붙어 보였기 때문이다. -->
            <Button x:Name="SubmitButton" Content="답안 제출 · 시험 종료"
                    Margin="0,14,0,0" Padding="0,12" Cursor="Hand"
                    FontSize="{StaticResource FontSmall}" FontWeight="Bold"
                    Foreground="White" Background="#2563EB" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══ 알림 · 채팅 ══  자유 PIP 와 같은 것을 쓴다(NoticeChatPanel) -->
            <local:NoticeChatPanel/>
        </StackPanel>
    </Border>
</Window>
