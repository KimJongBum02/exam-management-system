<Page x:Class="StudentUI.View.StudentExamView.StudentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentUI.View.StudentExamView"
      mc:Ignorable="d" 
      Background="#F5F5F5"
      Title="StudentPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- 학생 정보 -->
            <local:StudentInformation Margin="0,0,0,12"/>
            <!-- 시험 타이머-->
            <local:StudentTimer Margin="0,0,0,12"/>
            <!-- 파일 수신 및 시험 응시-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:StudentFile Grid.Column="0" VerticalAlignment="Stretch"/>
                <local:StudentExamState Grid.Column="2" VerticalAlignment="Stretch"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
