<Window x:Class="StudentUI.View.LoginView.IPInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="교수 PC 연결"
        Height="280"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            CornerRadius="12"
            Padding="32,28">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2"
                              BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>

            <TextBlock Text="교수 PC 연결"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1A1A1A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="교수 PC의 IP 주소를 입력해 주세요."
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock Text="IP 주소"
                       FontSize="13"
                       Foreground="#444444"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="IPTextBox"
                     FontSize="14"
                     Foreground="#1A1A1A"
                     Background="#F8F9FA"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"
                     Padding="10,8"
                     Margin="0,0,0,20"/>

            <Button x:Name="ConnectButton"
                    IsDefault="True"
                    Height="44"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ConnectBorder"
                                Background="#5C6AC4"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ConnectBorder" Property="Background" Value="#4C5AB4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ConnectBorder" Property="Background" Value="#3C4AA4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="연결하기"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Button>

        </StackPanel>
    </Border>
</Window>