<UserControl x:Class="StudentUI.View.LoginView.StudentInputNumber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.LoginView"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="학번"
                   FontSize="12"
                   Foreground="#6B7280"
                   Margin="0,0,0,6"/>
        <Border BorderBrush="#2A2D31" BorderThickness="1" CornerRadius="6"
                Background="White">
            <TextBox x:Name="StudentNumber"
                     FontSize="13"
                     Foreground="#1F2328"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,10"
                     Height="38"
                     VerticalContentAlignment="Center"
                     Text="{Binding Student.StudentNumber, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>
        <TextBlock Text="{Binding NumberError}" FontSize="11" Foreground="#D32F2F" Margin="2,4,0,0"/>
    </StackPanel>
</UserControl>