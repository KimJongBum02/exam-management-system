<UserControl x:Class="StudentUI.View.LoginView.StudentInputNumber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.LoginView"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="학번"
                   FontSize="13"
                   Foreground="#64748B"
                   FontWeight="SemiBold"
                   Margin="5,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="StudentNumber"
                     Grid.Column="1"
                     FontSize="14"
                     Foreground="#1E293B"
                     Background="Transparent"
                     BorderThickness="0,0,0,1"
                     BorderBrush="#CBD5E1"
                     Padding="0,4"
                     Text="{Binding Student.StudentNumber, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <TextBlock Text="{Binding NumberError}" FontSize="11" Foreground="#D32F2F" Margin="5,4,0,0"/>
    </StackPanel>
</UserControl>