<UserControl x:Class="StudentUI.View.LoginView.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StudentUI.View.LoginView"
      xmlns:vm="clr-namespace:StudentUI.ViewModel"
      mc:Ignorable="d">

    <Grid>
        <!-- 배경 그라데이션 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF2FF" Offset="0"/>
                <GradientStop Color="#E0E7FF" Offset="0.5"/>
                <GradientStop Color="#F0F9FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 배경 장식: 좌상단 큰 원 -->
        <Ellipse Width="480" Height="480"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-160,-160,0,0"
                 Opacity="0.45">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#C7D2FE" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 배경 장식: 우하단 원 -->
        <Ellipse Width="380" Height="380"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-120,-120"
                 Opacity="0.40">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A5F3FC" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 배경 장식: 중앙 우측 작은 원 -->
        <Ellipse Width="200" Height="200"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,80,-60,0"
                 Opacity="0.30">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#818CF8" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 로그인 카드 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="400"
                Background="White"
                CornerRadius="16"
                Padding="40,36,40,40">
            <Border.Effect>
                <DropShadowEffect Color="#6366F1"
                                  Direction="270"
                                  ShadowDepth="8"
                                  BlurRadius="40"
                                  Opacity="0.12"/>
            </Border.Effect>

            <StackPanel>
                <local:StudentLogin Margin="0,0,0,24"/>
                <local:StudentInputName x:Name="NameInput" Margin="0,0,0,16"/>
                <local:StudentInputNumber x:Name="NumberInput" Margin="0,0,0,28"/>
                <local:LoginButton x:Name="LoginBtn"/>
                <!-- 교수 PC 를 찾는 동안 보여 줄 한 줄 -->
                <TextBlock Text="{Binding ConnectStatus}" FontSize="11" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>