<Page x:Class="StudentUI.View.LoginView.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StudentUI.View.LoginView"
       xmlns:vm="clr-namespace:StudentUI.ViewModel"
      mc:Ignorable="d">

    <Page.DataContext>
        <vm:LoginViewModel/>
    </Page.DataContext>
    
    <Page.Background>
        <ImageBrush ImageSource="/View/LoginView/Assets/loginbackground.png"
                Stretch="UniformToFill"/>
    </Page.Background>

    <Grid>
        <!-- 반투명 흰색 레이어 -->
        <Rectangle Fill="White" Opacity="0.5"/>

        <!-- 로그인 테두리 -->
        <Border Background="White"
                CornerRadius="12"
                Padding="40,36"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.92"
                >
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08"
                                  BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <local:StudentLogin Margin="0,0,0,16"/>
                <local:StudentInputNumber x:Name="NumberInput" Margin="0,0,0,12"/>
                <local:StudentInputName x:Name="NameInput" Margin="0,0,0,12"/>
                <local:LoginButton x:Name="LoginBtn"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>