<Window x:Class="StudentUI.View.Shared.RemoteControlBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원격 제어 알림" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Focusable="False" ShowActivated="False" IsHitTestVisible="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 글자 크기는 교수 앱과 한 벌을 나눠 쓴다 (ExamManager\Shared\FontSizes.xaml) -->
                <ResourceDictionary Source="pack://application:,,,/StudentUI;component/FontSizes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Frame" Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" ShadowDepth="4" BlurRadius="16"/>
        </Border.Effect>

        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText" Grid.Column="0" Text="🖥" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="원격 제어 중입니다."
                           FontSize="{StaticResource FontSmall}" FontWeight="Bold" Foreground="#1E40AF"/>
                <TextBlock x:Name="DetailText"
                           Text="교수님이 이 PC 의 화면을 보며 직접 조작하고 있습니다. 마우스·키보드를 함께 쓰면 서로 방해됩니다."
                           FontSize="{StaticResource FontTiny}" Foreground="#1D4ED8" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
