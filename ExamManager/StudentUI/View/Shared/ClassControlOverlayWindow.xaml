<Window x:Class="StudentUI.View.Shared.ClassControlOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수업 통제" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Background="#0F172A">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="IconText" Text="&#x1F512;" FontSize="80"
                       HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock x:Name="TitleText" Text="수업 통제 중입니다" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="White" Margin="0,24,0,0"/>
            <TextBlock x:Name="SubText" Text="교수님 화면에 집중해 주세요."
                       FontSize="20" HorizontalAlignment="Center" Foreground="#CBD5E1" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
