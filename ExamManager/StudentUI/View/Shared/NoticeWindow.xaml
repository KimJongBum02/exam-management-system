<Window x:Class="StudentUI.View.Shared.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="전체 공지" Height="260" Width="420"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12" ShadowDepth="4" BlurRadius="14"/>
        </Border.Effect>

        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="전체 공지" FontSize="13" FontWeight="Bold" Foreground="#64748B"
                       Margin="0,0,0,14"/>

            <!-- 공지 본문. 길어질 수 있어 남는 공간을 다 쓴다 -->
            <TextBlock Grid.Row="1" x:Name="NoticeText" FontSize="16" Foreground="#1E293B"
                       TextWrapping="Wrap" LineHeight="26" VerticalAlignment="Center"/>

            <Button Grid.Row="2" Content="확인" Click="Confirm_Click"
                    HorizontalAlignment="Center" Margin="0,20,0,0"
                    Width="120" Height="42" FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
