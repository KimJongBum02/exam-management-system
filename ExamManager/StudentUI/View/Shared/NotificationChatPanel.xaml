<UserControl x:Class="StudentUI.View.Shared.NotificationChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- 대기/시작 화면이 공유하는 알림·채팅 버튼 + 펼침 패널.
         DataContext(뷰모델)에 IsNotificationOpen / IsChatOpen /
         ToggleNotificationCommand / ToggleChatCommand 가 있어야 한다. -->
    <StackPanel>
        <!-- 알림 / 채팅 버튼 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding ToggleNotificationCommand}" Content="🔔 알림"
                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Height="36" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Grid.Column="2" Command="{Binding ToggleChatCommand}" Content="💬 채팅"
                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Height="36" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 알림 패널 -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                Margin="0,0,0,10"
                Visibility="{Binding IsNotificationOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10" Background="#FEF2F2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="알림" FontSize="13" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 적발 내역이 없을 때 -->
                        <TextBlock Text="새로운 알림이 없습니다." Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,30">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCheatWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 감시에 걸린 내역 (최근 것이 위) -->
                        <ItemsControl ItemsSource="{Binding CheatWarnings}" Margin="10"
                                      Visibility="{Binding HasCheatWarnings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Bold"
                                                           Foreground="#B91C1C" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="시험 중에는 실행할 수 없습니다." FontSize="11"
                                                       Foreground="#EF4444" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 채팅 패널 -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                Margin="0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10" Background="#F8FAFC">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="채팅" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="320" MinHeight="160" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 내용이 없을 때 텍스트 표시 (메시지가 생기면 자동 숨김) -->
                        <TextBlock Text="채팅 내역이 없습니다." Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,30"
                                   Visibility="{Binding ChatVM.HasNoMessages, Converter={StaticResource BoolToVis}}"/>

                        <!-- 메시지 리스트 바인딩 -->
                        <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding SenderName}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="MsgBorder" Background="#F1F5F9" CornerRadius="6" Padding="8,6" MaxWidth="180" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="#1E293B"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontSize="9" Foreground="#CBD5E1" 
                                                       VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter TargetName="MsgBorder" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="MsgBorder" Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ChatVM.InputMessage, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                 Padding="8" VerticalContentAlignment="Center" FontSize="11">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChatVM.SendMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="전송" Command="{Binding ChatVM.SendMessageCommand}" Background="#1A56DB" Foreground="White"
                                Width="48" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0" FontSize="11"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
