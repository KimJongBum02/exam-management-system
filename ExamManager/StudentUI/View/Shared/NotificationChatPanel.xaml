<UserControl x:Class="StudentUI.View.Shared.NotificationChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- 대기/시작 화면이 공유하는 알림·채팅 버튼 + 펼침 패널.
         DataContext(뷰모델)에 IsNotificationOpen / IsChatOpen /
         ToggleNotificationCommand / ToggleChatCommand 가 있어야 한다. -->
    <StackPanel>
        <!-- 알림 / 채팅 버튼 -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding ToggleNotificationCommand}" Content="🔔 알림"
                    Background="#F1F5F9" BorderThickness="0" Padding="5" Cursor="Hand" FontSize="11"/>
            <Button Grid.Column="2" Command="{Binding ToggleChatCommand}" Content="💬 채팅"
                    Background="#F1F5F9" BorderThickness="0" Padding="5" Cursor="Hand" FontSize="11"/>
        </Grid>

        <!-- 알림 패널 -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                Margin="0,10,0,0"
                Visibility="{Binding IsNotificationOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                    <TextBlock Text="🔔 부정행위 알림" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                </Border>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="새로운 알림이 없습니다." Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,20"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 채팅 패널 -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                Margin="0,10,0,0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                    <TextBlock Text="💬 채팅" FontSize="13" FontWeight="Bold" Foreground="#1A1A2E"/>
                </Border>
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="채팅 내역이 없습니다." Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,20"/>
                </ScrollViewer>
                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                 Padding="8" VerticalContentAlignment="Center" FontSize="11"/>
                        <Button Grid.Column="1" Content="전송" Background="#1A56DB" Foreground="White"
                                Width="48" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0" FontSize="11"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
