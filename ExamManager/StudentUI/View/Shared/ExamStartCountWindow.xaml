<Window x:Class="StudentUI.View.Shared.ExamStartCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시험 준비" Width="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Focusable="False" ShowActivated="False" IsHitTestVisible="False">
    <!-- IsHitTestVisible=False — 학생이 뒤의 자기 앱을 눌러 저장할 수 있게 클릭을 가로채지 않는다 -->
    <Border Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" ShadowDepth="4" BlurRadius="16"/>
        </Border.Effect>
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="⏳" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="곧 시험이 시작됩니다." FontSize="16" FontWeight="Bold" Foreground="#FDE68A"/>
                <TextBlock x:Name="MsgText" Text="실행 중인 프로그램이 정리됩니다. 지금 저장해 주세요."
                           FontSize="13" Foreground="#E2E8F0" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
