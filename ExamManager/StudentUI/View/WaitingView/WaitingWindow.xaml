<Window x:Class="StudentUI.View.WaitingView.WaitingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentUI.View.WaitingView"
        xmlns:shared="clr-namespace:StudentUI.View.Shared"
        mc:Ignorable="d"
        Title="시험 대기" Height="152" Width="280"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.08" ShadowDepth="4" BlurRadius="12"/>
        </Border.Effect>
        <Grid Margin="15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 학생 정보 + 로그아웃 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StudentInfo}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LogoutCommand}" Content="로그아웃" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>
                    <Button Command="{Binding ExitCommand}" Content="종료" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: 대기 메시지 + 현재 시각 -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="현재는 시험 대기 중입니다." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" FontSize="12" FontWeight="Bold" Foreground="#1A56DB" FontFamily="Consolas, Arial" VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 2: 접속 상태 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#EF4444"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#16A34A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: 시험 파일 수신 상태 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#94A3B8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExamFile.IsReceived}" Value="True">
                                    <Setter Property="Fill" Value="#16A34A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ExamFile.StatusText}" FontSize="11" Foreground="#64748B"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Row 4: 준비 화면 전환 버튼 -->
            <Button Grid.Row="4" Command="{Binding TestExamCommand}" Content="시험 준비 화면으로 전환" Margin="0,8,0,0" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="5" Cursor="Hand" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Row 5: 시작 화면 전환 버튼 -->

            <!-- Row 6: 공용 알림/채팅 버튼 + 펼침 패널 (맨 하단) -->
            <shared:NotificationChatPanel Grid.Row="6"/>
        </Grid>
    </Border>
</Window>
