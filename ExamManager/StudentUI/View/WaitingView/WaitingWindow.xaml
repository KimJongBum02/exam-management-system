<Window x:Class="StudentUI.View.WaitingView.WaitingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentUI.View.WaitingView"
        mc:Ignorable="d"
        Title="시험 대기" Height="130" Width="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Border Background="White" CornerRadius="10" Margin="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="5"/>
        </Border.Effect>
        <Grid Margin="15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 학생 정보 + 로그아웃 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StudentInfo}" FontWeight="Bold" FontSize="14" Foreground="#333333" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LogoutCommand}" Content="로그아웃" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
                    <Button Command="{Binding ExitCommand}" Content="종료" Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: 대기 메시지 + 현재 시각 -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="현재는 시험 대기 중입니다." FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 2: 접속 상태 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E53935"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#43A047"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: 시험 시작 테스트 버튼 -->
            <Button Grid.Row="3" Command="{Binding TestExamCommand}" Content="시험 시작 테스트" Margin="0,8,0,0" Background="#E0E0E0" BorderThickness="0" Padding="5" Cursor="Hand" FontSize="11"/>
        </Grid>
    </Border>
</Window>
