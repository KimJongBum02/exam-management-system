<UserControl x:Class="StudentUI.View.LockScreenView.WaitingBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentUI.View.LockScreenView"
             mc:Ignorable="d">
    <Border Background="White"
            CornerRadius="12"
            Padding="40,36">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05"
                              BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">

            <!-- 아이콘 -->
            <Border Background="#E8F8EE"
                    CornerRadius="999"
                    Width="80" Height="80"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <TextBlock Text="⏳"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 시험 대기 중 -->
            <TextBlock Text="시험 대기 중"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A1A2E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- 안내 문구 -->
            <TextBlock Text="교수님이 시험을 시작할 때까지 잠시 기다려 주세요."
                       FontSize="13"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- 구분선 -->
            <Separator Background="#F0F0F0" Margin="0,0,0,20"/>

            <!-- 학생 정보 -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 이름 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="이름"
                                   FontSize="11"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Student.StudentName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Rectangle Grid.Column="1" Fill="#E0E0E0"/>

                    <!-- 학번 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="학번"
                                   FontSize="11"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Student.StudentNumber}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A2E"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Rectangle Grid.Column="3" Fill="#E0E0E0"/>

                    <!-- 상태 -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="상태"
                                   FontSize="11"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="대기 중"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
