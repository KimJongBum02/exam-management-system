<Window x:Class="ProfessorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sidebarviews="clr-namespace:ProfessorUI.View.SidebarView"
        xmlns:dashboard="clr-namespace:ProfessorUI.View.DashBoardCardView"
        xmlns:current="clr-namespace:ProfessorUI.View.CurrentTimeView"
        xmlns:chat="clr-namespace:ProfessorUI.View.ChatView"
        xmlns:notification="clr-namespace:ProfessorUI.View.NotificationView"
        xmlns:vm="clr-namespace:ProfessorUI.ViewModel"
        Title="MainWindow" Height="750" Width="1300" Background="#F5F5F5"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <chat:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationViewModel}">
            <notification:NotificationView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <sidebarviews:SidebarView Grid.Column="0" DataContext="{Binding SidebarViewModel}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                            Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="학생 접속 IP" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ServerAddress}" FontSize="14" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <notification:NotificationButtonView Margin="0,0,10,0"/>
                    <chat:ChatButtonView />
                    <Button Content="종료" Click="ExitButton_Click" Margin="14,0,0,0" Padding="14,6"
                            Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <dashboard:DashBoardCardView Grid.Column="0" DataContext="{Binding DashBoardCardVM}" Margin="20"/>

                        <current:CurrentTimeView Grid.Column="1" DataContext="{Binding CurrentTimeVM}" Margin="20"/>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Margin="20"/>
            </Grid>
            <Border Grid.Column="1" Width="340" Background="#F5F5F5" 
                BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"
                Visibility="{Binding LayoutStore.IsRightPaneVisible, Converter={StaticResource BoolToVis}}">
                <ContentPresenter Content="{Binding RightPaneViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>