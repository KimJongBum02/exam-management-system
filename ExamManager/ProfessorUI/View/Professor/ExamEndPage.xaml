<UserControl x:Class="ProfessorUI.View.Professor.ExamEndPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="시험 종료 및 답안 수집" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,14,0">
                    <Run Text="마지막 갱신:"/><Run Text=" "/><Run Text="{Binding Overview.LastUpdatedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="● 서버"/><Run Text=" "/><Run Text="{Binding Server.StatusText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- KPI 5종 -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,22">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="전체 학생" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.TotalCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="수집 완료" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CollectedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="미수집" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.NotCollectedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="정리 실패" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CleanupFailedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="완료율" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CompletionRate}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 답안 수집 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="답안 수집" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                           Text="접속 중인 학생에게 답안 제출을 요청합니다. 학생이 보내면 자동으로 저장되고 목록이 갱신됩니다."/>
                <TextBlock x:Name="CollectFolderText" Style="{StaticResource Caption}" Margin="0,0,0,16"
                           TextWrapping="Wrap"/>
                <Button Content="답안 일괄 수집 요청" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding AnswerCollect.CollectAllCommand}"/>
            </StackPanel>
        </Border>

        <!-- 표 머리 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="학생별 답안 수집 현황" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="전체 선택" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="SelectAll_Click"/>
                <Button Content="전체 해제" Style="{StaticResource SecondaryButton}" Click="DeselectAll_Click"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="4" x:Name="CollectTable" Style="{StaticResource FlatTable}" Height="360" Margin="0,0,0,24">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                    <GridViewColumn Header="승인 대상" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource CellCheck}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="학번" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="이름" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="접속 상태" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="수집 상태" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CollectText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="마지막 갱신" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LastUpdate}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="비고" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 승인 조건 -->
        <Border Grid.Row="5" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="승인 조건 안내" Style="{StaticResource FieldLabel}" Margin="0,0,0,14"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                           Text="승인은 답안 수집이 끝난 학생에게만 적용되며, 해당 학생 PC에 종료 명령을 보냅니다. 시험 흔적은 학생이 답안 회신을 받은 뒤 스스로 지웁니다."/>
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,18"
                           Text="미수집 학생은 선택해도 승인 대상에서 제외됩니다. 이 작업은 되돌릴 수 없습니다."/>
                <Button Content="{Binding Overview.ApproveTargetText}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Command="{Binding ExamEnd.ApproveSelectedCommand}"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="6" Content="종료 완료 현황 보기" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="ShowSummary_Click"/>
    </Grid>
</UserControl>
