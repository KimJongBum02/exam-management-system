<UserControl x:Class="ProfessorUI.View.Professor.ExamManagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 (마지막 갱신·서버 상태는 상단바에 있다) -->
        <TextBlock Grid.Row="0" Text="시험 관리 창" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

        <!-- KPI 6종 -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,22">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="전체 학생" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.TotalCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="접속 중" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.ConnectedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="미접속" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.NotConnectedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="시험 진행 중" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.InProgressCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <!-- 학생이 먼저 제출하고 끝낸 경우. 시험 중에도 이 숫자가 올라간다 -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="제출 완료" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.SubmittedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="파일 미수신" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.FileMissingCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="보안 경고" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.AlertCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 검색 · 필터 · 재배포 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Bottom">
            <TextBox x:Name="SearchBox" Width="290" Style="{StaticResource SearchBox}" VerticalAlignment="Bottom"
                     Foreground="{StaticResource TextPrimary}" TextChanged="Filter_Changed"/>
            <StackPanel Margin="14,0,0,0">
                <TextBlock Text="접속 상태" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ConnFilter" Style="{StaticResource FilterCombo}" SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="전체"/>
                    <ComboBoxItem Content="접속 중"/>
                    <ComboBoxItem Content="미접속"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="시험 상태" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StateFilter" Style="{StaticResource FilterCombo}" SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="전체"/>
                    <ComboBoxItem Content="대기"/>
                    <ComboBoxItem Content="수신완료"/>
                    <ComboBoxItem Content="제출완료"/>
                    <ComboBoxItem Content="부정행위 감지"/>
                </ComboBox>
            </StackPanel>
            <Button Content="선택 학생 재배포" Style="{StaticResource SecondaryButton}"
                    Margin="14,0,0,0" VerticalAlignment="Bottom"
                    Command="{Binding Distribute.StartDeployCommand}"/>
        </StackPanel>

        <!-- 학생 목록 -->
        <ListView Grid.Row="3" x:Name="StudentTable" Style="{StaticResource FlatTable}" Height="380" Margin="0,0,0,26">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                    <GridViewColumn Header="학번" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="이름" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="접속 상태" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="시험 상태" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="감시" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MonitorText}" Style="{StaticResource Cell}"
                                           ToolTip="{Binding MonitorDetail}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="마지막 갱신" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LastUpdate}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="조치" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="재배포" Style="{StaticResource CellLink}"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.Distribute.RedeployOneCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 보안 경고 · 실시간 채팅 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="보안 경고" Style="{StaticResource SectionTitle}"/>
                <ItemsControl x:Name="AlertList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                                        <TextBlock Text="{Binding Who}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                            <Run Text="{Binding Description, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Time, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Content="상세 확인" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="AlertDetail_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="보안 정책 관리" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="SecurityPolicy_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="실시간 채팅" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <ItemsControl x:Name="ChatList" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SenderName}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="전체 학생에게 공지" Style="{StaticResource FieldLabel}"/>
                        <TextBox Height="96" Style="{StaticResource NoteBox}"
                                 Foreground="{StaticResource TextPrimary}"
                                 Text="{Binding Chat.InputMessage, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="전송" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Chat.SendMessageCommand}"
                                HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 종료 진입. 이미 제출한 학생은 그대로 두고, 남은 학생의 시험만 끝낸다 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="아직 제출하지 않은 학생의 시험을 종료합니다. 조기 제출한 학생의 답안은 이미 수집되어 있습니다."/>
            <Button Content="시험 종료 및 답안 수집" Style="{StaticResource PrimaryButton}" Click="EndExam_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
