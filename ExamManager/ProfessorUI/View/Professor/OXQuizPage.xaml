<UserControl x:Class="ProfessorUI.View.Professor.OXQuizPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 정답 O / X 고르기. 고른 쪽만 진한 테두리로 남긴다 -->
            <Style x:Key="AnswerChoice" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="86"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtle}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BtnDark}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="OX 퀴즈" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="QuizCountText" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding Quiz.FeedbackMessage}" Style="{StaticResource Caption}"/>
            </StackPanel>
        </Grid>

        <!-- 좌: 문제 목록 · 우: 문제 편집 + 출제 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="문제 목록" Style="{StaticResource SectionTitle}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchBox" Width="300" Style="{StaticResource SearchBox}"
                             VerticalAlignment="Bottom" Foreground="{StaticResource TextPrimary}"
                             TextChanged="Filter_Changed"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="상태" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StateFilter" Style="{StaticResource FilterCombo}" SelectedIndex="0"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="전체"/>
                            <ComboBoxItem Content="완성"/>
                            <ComboBoxItem Content="미완성"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="새 문제" Style="{StaticResource SecondaryButton}"
                            Margin="14,0,0,0" VerticalAlignment="Bottom"
                            Command="{Binding Quiz.NewCommand}"/>
                </StackPanel>

                <ListView Grid.Row="2" x:Name="QuizTable" Style="{StaticResource FlatTable}" Height="470"
                          SelectedItem="{Binding Quiz.SelectedQuiz}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                            <GridViewColumn Header="분류" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Category}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="문제" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Question}" Style="{StaticResource Cell}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="정답" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding AnswerText}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="상태" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StateText}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="문제 편집" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="분류" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FilterCombo}" IsEditable="True"
                                  ItemsSource="{Binding Quiz.Categories}"
                                  Text="{Binding Quiz.CurrentCategory, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,18"/>

                        <TextBlock Text="문제" Style="{StaticResource FieldLabel}"/>
                        <TextBox Height="112" Style="{StaticResource NoteBox}" Margin="0,0,0,18"
                                 Foreground="{StaticResource TextPrimary}"
                                 Text="{Binding Quiz.CurrentQuestion, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="정답" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton Style="{StaticResource AnswerChoice}" GroupName="Answer"
                                         AutomationProperties.Name="정답 O"
                                         IsChecked="{Binding Quiz.IsOSelected}">
                                <TextBlock Text="O" FontSize="21" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource AnswerChoice}" GroupName="Answer"
                                         AutomationProperties.Name="정답 X"
                                         IsChecked="{Binding Quiz.IsXSelected}">
                                <TextBlock Text="X" FontSize="21" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="새로 만들기" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding Quiz.NewCommand}"/>
                            <Button Content="삭제" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding Quiz.DeleteCommand}"/>
                            <Button Content="저장" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding Quiz.SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="학생에게 출제" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                                   Text="선택한 문제를 시험 중인 학생 화면에 띄우고 응답을 받습니다."/>
                        <TextBlock x:Name="SendHint" Style="{StaticResource Caption}" Margin="0,0,0,18"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="SendQuizButton" Content="출제하기" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="AskQuiz_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ 출제 현황 ═══ -->
        <Grid Grid.Row="2" Margin="0,30,0,12">
            <TextBlock Text="출제 현황" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <CheckBox x:Name="SortWrongFirst" Content="오답·미응답 먼저 보기" IsChecked="True"
                          Checked="SortToggle_Changed" Unchecked="SortToggle_Changed"
                          FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="기록 비우기" Style="{StaticResource SecondaryButton}" Click="ClearSession_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 방금 낸 문제와 학생별 응답 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="RoundCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="RoundLabel" Text="방금 낸 문제" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RoundQuestion" Style="{StaticResource Body}" Margin="0,0,0,16"
                                   Text="아직 낸 문제가 없습니다."/>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="정답" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RoundAnswer" Text="-" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="맞음" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RoundCorrect" Text="0" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="틀림" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RoundWrong" Text="0" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="미응답" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="RoundMissed" Text="0" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <ListView Grid.Row="1" x:Name="ResponseTable" Style="{StaticResource FlatTable}" Height="320">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                            <GridViewColumn Header="학번" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="이름" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StudentName}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="응답" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding AnswerText}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="결과" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ResultText}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="응답 시각" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding RespondedAt}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- 우: 학생별 누적. 수업 태도를 볼 때 실제로 쓰이는 표다 -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="학생별 누적" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TallyHint" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="이번 세션에서 낸 문제를 모두 합친 것입니다."/>
                <ListView x:Name="TallyTable" Style="{StaticResource FlatTable}" Height="404">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                            <GridViewColumn Header="학번" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="이름" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StudentName}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="응답" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding AnsweredCount}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="맞음" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding CorrectCount}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="미응답" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding MissedCount}" Style="{StaticResource Cell}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
