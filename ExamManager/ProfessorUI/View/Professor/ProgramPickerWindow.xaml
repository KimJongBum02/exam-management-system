<Window x:Class="ProfessorUI.View.Professor.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로그램 찾기" Height="700" Width="840"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 줄 아무 데나 눌러도 골라지도록 한 목록 행 -->
            <Style x:Key="PickRow" TargetType="ListViewItem" BasedOn="{StaticResource TableRow}">
                <EventSetter Event="MouseLeftButtonUp" Handler="Row_Click"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Setter Property="ToolTip" Value="이미 목록에 있습니다"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CannotBeAllowed}" Value="True">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Setter Property="ToolTip" Value="원래 이름 정보가 없어 허용 목록에 넣을 수 없습니다"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisible"/>

            <!-- 고른 항목 하나 (이름 + 빼기) -->
            <Style x:Key="ChipRemove" TargetType="Button" BasedOn="{StaticResource LinkButton}">
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 안내 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="감시 목록에 넣을 프로그램" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="한글 이름(카카오톡)으로도, 실행 파일 이름(KakaoTalk.exe)으로도 찾을 수 있습니다. 목록에 없으면 [직접 찾아보기]로 프로그램이나 바탕화면 바로가기를 고르세요."/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="줄을 누르면 아래 [고른 프로그램]에 담기고, 다시 누르면 빠집니다. 여러 개를 한 번에 담을 수 있으며, [추가됨]으로 표시된 것은 이미 목록에 있어 고를 수 없습니다."/>
            <TextBlock x:Name="WhiteListNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="허용 목록은 실행 파일 이름과 원래 이름이 둘 다 맞아야 인정됩니다. 두 이름이 다르면 목록에 두 줄로 들어가며, 원래 이름이 없는 프로그램은 [허용 불가]로 표시되어 고를 수 없습니다."/>
        </StackPanel>

        <!-- 검색 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Foreground="{StaticResource TextPrimary}"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="직접 찾아보기" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="Browse_Click"/>
            <Button Grid.Column="2" Content="새로 고침" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="Refresh_Click"/>
        </Grid>

        <!-- 목록 -->
        <Grid Grid.Row="2">
            <ListView x:Name="ProgramList" Style="{StaticResource FlatTable}"
                      ItemContainerStyle="{StaticResource PickRow}"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                        <GridViewColumn Header="" Width="38">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 표시 전용. 고르는 것은 줄 전체를 누르는 것으로 한다 -->
                                    <CheckBox IsHitTestVisible="False" Focusable="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
                                                <Setter Property="IsChecked" Value="{Binding IsChosen, Mode=OneWay}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="프로그램 이름" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="실행 파일" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExecutableName}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="출처" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="상태" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 목록을 훑는 동안 -->
            <Border x:Name="LoadingCover" Background="#FFFFFF">
                <TextBlock Text="설치된 프로그램을 찾는 중입니다…" Style="{StaticResource Body}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 고른 것 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="ChosenTitle" Text="고른 프로그램 0개" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="ChosenEmptyText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="아직 고른 것이 없습니다. 위 목록에서 줄을 누르세요."/>
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl x:Name="ChosenList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSubtle}"
                                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource TextPrimary}">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ExecutableName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0"
                                                       Visibility="{Binding HasDistinctOriginalName, Converter={StaticResource BoolToVisible}}">
                                                <Run Text="+ "/><Run Text="{Binding OriginalName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Content="✕" Style="{StaticResource ChipRemove}"
                                                ToolTip="빼기" Click="RemoveChosen_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 확인 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="선택 항목 추가" Style="{StaticResource PrimaryButton}"
                        Padding="16,8" Margin="10,0,0,0" IsDefault="True" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
