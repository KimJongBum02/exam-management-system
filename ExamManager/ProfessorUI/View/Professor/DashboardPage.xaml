<UserControl x:Class="ProfessorUI.View.Professor.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 + 갱신 상태 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="시험 운영 대시보드" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,14,0">
                    <Run Text="마지막 갱신:"/><Run Text=" "/><Run Text="{Binding Overview.LastUpdatedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="● 서버"/><Run Text=" "/><Run Text="{Binding Server.StatusText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- KPI 4종 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,26">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="시험 운영 상태" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.PhaseText}" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Overview.PhaseSubText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="접속 학생" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.ConnectedText}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Overview.NotConnectedText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="부정행위 경고" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.AlertText}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Overview.AlertStudentText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="답안 수집" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CollectedText}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Overview.CollectedSubText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 실시간 학생 현황 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="실시간 학생 현황" Style="{StaticResource SectionTitle}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                    <TextBox Width="290" Text="학번 또는 이름 검색" Style="{StaticResource SearchBox}"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="상태 필터" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FilterCombo}" SelectedIndex="0">
                            <ComboBoxItem Content="전체"/>
                            <ComboBoxItem Content="접속 중"/>
                            <ComboBoxItem Content="미접속"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <ListView Grid.Row="2" x:Name="StudentTable" Style="{StaticResource FlatTable}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                            <GridViewColumn Header="학번" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="이름" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="접속 상태" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="시험 상태" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="최근 갱신" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastUpdate}" Style="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- 우: 우선 대응 + 보안 요약 + 마법사 진입 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="우선 대응 항목" Style="{StaticResource SectionTitle}"/>

                <ItemsControl Grid.Row="1" x:Name="PriorityList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="보안 이벤트 요약" Style="{StaticResource SectionTitle}" Margin="0,14,0,10"/>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="누적 부정행위 경고" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding Overview.AlertText}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="경고 발생 학생" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding Overview.AlertStudentCount}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="파일 미수신 학생" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding Overview.FileMissingCount}" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Grid.Row="5" Content="시험 준비 화면으로 이동" Style="{StaticResource PrimaryButton}"
                        Click="StartWizard_Click" Margin="0,18,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
