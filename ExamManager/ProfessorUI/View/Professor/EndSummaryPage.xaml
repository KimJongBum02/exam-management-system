<UserControl x:Class="ProfessorUI.View.Professor.EndSummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="종료 완료 현황" Style="{StaticResource PageTitle}"/>
            <Button Content="답안 수집 화면으로" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="BackToEnd_Click"/>
        </Grid>

        <!-- KPI 4종 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,26">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="답안 수집 완료" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CollectedText}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Overview.CompletionRate}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="PC 종료 승인" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.ApprovedText}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="수집 완료 기준" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="정리 실패" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.CleanupFailedCount}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="학생 PC 확인 필요" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="미수집" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Overview.NotCollectedCount}" Style="{StaticResource KpiValue}" Margin="0,0,0,6"/>
                    <TextBlock Text="현장 조치 필요" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="학생별 종료 처리 상태" Style="{StaticResource SectionTitle}"/>

        <ListView Grid.Row="3" x:Name="EndTable" Style="{StaticResource FlatTable}" Height="360" Margin="0,0,0,26">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                    <GridViewColumn Header="학번" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="이름" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="답안 수집" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CollectText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="흔적 삭제" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CleanupText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="PC 종료" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ShutdownText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="비고" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="4" Text="미완료 및 오류 안내" Style="{StaticResource SectionTitle}"/>

        <StackPanel Grid.Row="5">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Overview.EndSummaryText}" Style="{StaticResource FieldLabel}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="답안 미수집" Style="{StaticResource Body}" Width="110"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="학생이 제출하지 않았거나 연결이 끊긴 경우입니다. 해당 학생의 PC 종료는 실행되지 않았습니다."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="정리 실패" Style="{StaticResource Body}" Width="110"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="답안은 받았으나 학생 PC에 시험 파일이 남아 있습니다. 다음 사람이 앉기 전에 직접 확인해야 합니다."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PC 종료 미실행" Style="{StaticResource Body}" Width="110"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="승인하지 않았거나 이미 접속이 끊긴 학생입니다. 현장에서 직접 종료를 확인하십시오."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource BgSubtle}">
                <StackPanel>
                    <TextBlock Text="다음 시험 준비" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,18"
                               Text="처음 화면으로 돌아가면 시험 단계와 학생별 진행 상태가 초기화됩니다. 걷은 답안 파일은 지워지지 않습니다."/>
                    <Button Content="처음 화면으로 (새 시험 준비)" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="RestartSession_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
