<Window x:Class="ProfessorUI.View.Professor.DetailMonitoring"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="화면 상세 보기"
        Width="920" Height="620"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#1A1D21"
        Style="{DynamicResource AppWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 어두운 상세 화면에서 쓰는 작은 버튼(개별 상태 전환) -->
            <Style x:Key="DetailDarkButton" TargetType="Button">
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#334155"/>
                <Setter Property="Foreground" Value="#F1F5F9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="NameText" FontSize="{StaticResource FontXLarge}" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="UpdatedText" FontSize="{StaticResource FontSmall}"
                           Foreground="#B4BBC4" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- 이 화면은 바탕이 어두워 테두리형(보조) 버튼이 묻힌다. 닫기는 채움형을 쓴다 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 이 학생만 상태 전환(전체 일괄은 상단바에서). 보낸 뒤 효과는 아래 화면 썸네일로 확인한다 -->
                <TextBlock Text="상태" FontSize="{StaticResource FontSmall}" Foreground="#B4BBC4"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="자유" Click="ClassModeFree_Click" Style="{StaticResource DetailDarkButton}"/>
                <Button Content="통제" Click="ClassModeLocked_Click" Style="{StaticResource DetailDarkButton}"/>
                <Button Content="시험" Click="ClassModeExam_Click" Style="{StaticResource DetailDarkButton}" Margin="0,0,14,0"/>
                <Button x:Name="KeyboardLockButton" Content="🔒  키보드 잠금"
                        Click="KeyboardLock_Click" Margin="0,0,10,0"
                        Padding="14,6" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                        Cursor="Hand" Background="#334155" Foreground="#F1F5F9" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="✕  닫기" Style="{StaticResource PrimaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── 화면 이미지 ── -->
        <Border Grid.Row="1" Background="#0D0F12" CornerRadius="8">
            <Grid>
                <!-- 이미지 -->
                <Image x:Name="ScreenImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- 수신 전 안내 -->
                <TextBlock x:Name="WaitingText" Text="화면 수신 대기 중…"
                           Foreground="#A8B0BA" FontSize="{StaticResource FontLarge}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── 하단 바 ── -->
        <TextBlock Grid.Row="2" x:Name="ResolutionText"
                   Text="1280 × 720 · JPEG" Foreground="#A8B0BA" FontSize="{StaticResource FontMini}"
                   HorizontalAlignment="Right" Margin="0,8,0,0"/>
    </Grid>
</Window>
