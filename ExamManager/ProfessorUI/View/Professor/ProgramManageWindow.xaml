<UserControl x:Class="ProfessorUI.View.Professor.ProgramManageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProfessorUI.View.Professor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 (마지막 갱신·서버 상태는 상단바에 있다) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <local:BackButton/>
            <TextBlock Text="프로그램 관리" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 현재 정책 상태 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="현재 적용 상태" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="정책 적용 상태" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PolicyStateText" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="허용 프로그램" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding WhiteList.WhiteList.Count}" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="금지 프로그램" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding BlackList.BlackList.Count}" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="미확인 경고" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Overview.UnreadAlertCount}" Style="{StaticResource Body}"
                                   Foreground="{StaticResource AlertRed}" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="목록을 고친 뒤 [학생 PC에 적용]을 눌러야 반영됩니다. 금지 프로그램 차단은 학생용 프로그램이 수행하며, 이 화면에서는 목록 편집과 전송만 합니다."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 금지 / 허용 목록 -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="금지 프로그램 목록" Style="{StaticResource SectionTitle}" Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BlackList.BlackList.Count}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="기본값 복원" Style="{StaticResource LinkButton}"
                                        Margin="0,0,12,0" Command="{Binding BlackList.RestoreDefaultsCommand}"/>
                                <Button Content="전체 삭제" Style="{StaticResource LinkButton}"
                                        Command="{Binding BlackList.ClearAllCommand}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Text="{Binding BlackList.InputProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="목록에서 찾기" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="10,0,0,0" Click="PickBlack_Click"/>
                            <Button Grid.Column="2" Content="항목 추가" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" Margin="8,0,0,0" Command="{Binding BlackList.AddCommand}"/>
                        </Grid>
                        <!-- 목록은 길어서 펼치지 않고 [보기]로 팝업에 띄운다. 저장은 한 목록이다(BlackListViewModel) -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="목록은 [보기]를 눌러 창에서 확인·삭제할 수 있습니다. 기본 제공 항목은 생성형 AI 이며, 직접 추가한 항목과 나눠 둡니다."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="기본 제공 목록 보기" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Click="ShowBlackDefaults_Click"/>
                            <Button Content="직접 추가한 목록 보기" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="8,0,0,0" Click="ShowBlackAdded_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="허용 프로그램 목록" Style="{StaticResource SectionTitle}" Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding WhiteList.WhiteList.Count}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="전체 삭제" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding WhiteList.ClearAllCommand}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Text="{Binding WhiteList.InputProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="목록에서 찾기" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="10,0,0,0" Click="PickWhite_Click"/>
                            <Button Grid.Column="2" Content="항목 추가" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" Margin="8,0,0,0" Command="{Binding WhiteList.AddCommand}"/>
                        </Grid>
                        <Button Content="허용 목록 보기" Style="{StaticResource SecondaryButton}"
                                Padding="16,8" HorizontalAlignment="Left" Click="ShowWhite_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 우: 학생 PC 적용 + 경고 요약 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="학생 PC에 적용" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                   Text="지금 목록을 접속 중인 모든 학생 PC에 보냅니다. 학생 쪽 감시 목록이 즉시 교체됩니다."/>
                        <TextBlock x:Name="ApplyHint" Style="{StaticResource Caption}" Margin="0,0,0,18"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="ApplyButton" Content="학생 PC에 적용" Style="{StaticResource PrimaryButton}"
                                Click="ApplyPolicy_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="보안 경고 요약" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="AlertSummary" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 경고는 연붉은 칸에 담아 다른 안내와 구분한다 -->
                                    <Border Style="{StaticResource Card}" Background="{StaticResource AlertSoft}"
                                            BorderBrush="{StaticResource AlertRed}"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Who}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="전체 경고 내역 보기" Style="{StaticResource LinkButton}"
                                Click="ShowAllAlerts_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
