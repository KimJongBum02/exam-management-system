<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 색상 ── 와이어프레임의 무채색 팔레트를 그대로 옮긴 값 -->
    <SolidColorBrush x:Key="BgPage"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSidebar"     Color="#F7F7F8"/>
    <SolidColorBrush x:Key="BgSubtle"      Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BgHeader"      Color="#EDEDEE"/>
    <SolidColorBrush x:Key="BorderLight"   Color="#E5E7EB"/>
    <!-- 누를 수 있고 고칠 수 있는 것에만 쓰는 테두리.
         읽기 전용 상자와 한눈에 구분되도록 본문 글자색과 같은 검정을 쓴다. -->
    <SolidColorBrush x:Key="BorderStrong"   Color="#2A2D31"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#1F2328"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BtnDark"       Color="#2A2D31"/>
    <SolidColorBrush x:Key="BtnDarkHover"  Color="#3D4147"/>
    <SolidColorBrush x:Key="Placeholder"   Color="#E4E5E7"/>

    <!-- ── 카드 ── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPage}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- KPI 카드: 라벨 + 큰 숫자 + (선택) 부제 -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- ── 글자 ── -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- ── 버튼 ── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BtnDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDarkHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 보조 버튼도 검은 바탕에 흰 글씨다.
         버튼이 눌리는 것임을 한눈에 알아보게 하는 것이 우선이라 색은 주요 버튼과 맞추고,
         비중 차이는 크기(글자 굵기·여백)로만 준다. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="16,9"/>
    </Style>

    <!-- 본문 안의 밑줄 링크 (브레드크럼, "전체 경고 내역 보기" 등) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               TextDecorations="Underline"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 입력 ──
         고치거나 고를 수 있는 상자는 모두 검은 테두리다.
         읽기만 하는 상자(ReadOnlyBox)는 연한 테두리로 남겨 둘을 구분한다. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x2315;" FontSize="15" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="8,0,10,0"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 값을 보여 주기만 하는 상자. 돋보기도 검은 테두리도 없어 눌러 봐야 소용없음을 알린다 -->
    <Style x:Key="ReadOnlyBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 기본 콤보박스는 테두리 색을 테마가 정해 버려 BorderBrush 를 줘도 검게 되지 않는다.
         그래서 최소한의 틀을 직접 그린다. 편집 가능한 콤보(분류 입력)도 같은 틀을 쓴다. -->
    <Style x:Key="FilterCombo" TargetType="ComboBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="White" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="6"/>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,32,0" VerticalAlignment="Center"/>

                        <!-- 편집 가능일 때만 보인다. 이름이 PART_EditableTextBox 여야 콤보가 값을 읽어 간다 -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="12,0,32,0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextPrimary}"/>

                        <!-- 편집 가능일 때는 화살표 자리만 눌리게 좁힌다. 안 그러면 글자를 찍을 수 없다 -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Path Data="M0,0 L9,0 L4.5,5.5 Z" Fill="{StaticResource TextPrimary}" IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                            <Border Background="White" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Toggle" Property="Width" Value="32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoteBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <!-- 체크박스도 테마 색을 벗겨내고 검은 네모로 통일한다 -->
    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" VerticalAlignment="Center"
                                Background="White" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.4">
                            <Path x:Name="Mark" Data="M0,3.4 L3.1,6.5 L8.6,0.6" Stroke="White" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BtnDark}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 아직 못 하는 일에 붙이는 한 줄. 왜 잠겼는지를 자물쇠와 함께 적는다 -->
    <Style x:Key="LockNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ── 표 ── 선 없는 납작한 표. 헤더만 회색 띠 -->
    <Style x:Key="TableHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TableRow" TargetType="ListViewItem">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 이 값이 기본(Left)이면 셀이 열 너비를 못 받아 내용만큼만 넓어진다.
             그러면 셀 안에서 가운데로 보내 봐야 왼쪽에 붙어 버린다. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                        <!-- 여백은 셀마다 준다. 행 전체에 주면 헤더와 기준점이 달라져 한 칸씩 어긋난다 -->
                        <GridViewRowPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFAFB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F2F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatTable" TargetType="ListView">
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TableRow}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- 표 안의 셀 글자.
         헤더와 셀 모두 열 전체를 기준으로 가운데를 잡아야 세로로 줄이 맞는다.
         한쪽에만 여백을 주면 기준 상자가 달라져 중심이 어긋난다. -->
    <Style x:Key="Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- 칸을 가득 채운 뒤 글자를 가운데로 흘린다.
             HorizontalAlignment 로 상자를 가운데 두는 방식은 셀 컨테이너까지 닿지 않아
             왼쪽에 붙어 버린다. -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- 표 안의 링크(삭제 · 재배포 등) -->
    <Style x:Key="CellLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 표 안의 체크박스 -->
    <Style x:Key="CellCheck" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 학생 네모칸 현황 ──
         한 명이 한 칸이다. 표보다 자리를 많이 쓰지만 강의실을 훑듯이 볼 수 있어
         누가 빠졌는지 한눈에 들어온다. 미접속이면 칸 전체가 흐려진다. -->
    <Style x:Key="StudentCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="MinHeight" Value="104"/>
    </Style>

    <Style x:Key="StudentCardId" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StudentCardName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 칸 아래의 상태 배지. 접속 중이면 검은 띠, 미접속이면 회색 띠 -->
    <Style x:Key="StudentCardBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{StaticResource BtnDark}"/>
    </Style>

</ResourceDictionary>
