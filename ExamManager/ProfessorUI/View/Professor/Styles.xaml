<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:ProfessorUI.Common"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:conv="clr-namespace:ProfessorUI.Converter"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── 색상 ── 와이어프레임의 무채색 팔레트를 그대로 옮긴 값 -->
    <SolidColorBrush x:Key="BgPage"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSidebar"     Color="#F7F7F8"/>
    <SolidColorBrush x:Key="BgSubtle"      Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BgHeader"      Color="#EDEDEE"/>
    <SolidColorBrush x:Key="BorderLight"   Color="#8C94A0"/>
    <!-- 누를 수 있고 고칠 수 있는 것에만 쓰는 테두리.
         읽기 전용 상자와 한눈에 구분되도록 본문 글자색과 같은 검정을 쓴다. -->
    <SolidColorBrush x:Key="BorderStrong"   Color="#2A2D31"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#1F2328"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#3F4651"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#5A626D"/>
    <SolidColorBrush x:Key="BtnDark"       Color="#18181B"/>
    <SolidColorBrush x:Key="BtnDarkHover"  Color="#2E2E33"/>

    <!-- 교표 청록. 지금 눌러야 할 버튼 하나에만 쓴다 — 아무 데나 칠하면 강조가 사라진다.
         교표 원색(BrandTeal)은 흰 글씨 대비가 2.73:1 뿐이라 글씨를 얹지 못한다.
         그래서 글씨 없는 자리(로고 옆 띠)에만 쓰고, 버튼 바탕은 같은 색조를 어둡게 내린 값을 쓴다. -->
    <SolidColorBrush x:Key="BrandTeal"     Color="#1AB18B"/>

    <!-- 학생 프로그램이 쓰는 파랑을 그대로 가져왔다. 두 화면을 나란히 놓아도 따로 놀지 않는다. -->
    <SolidColorBrush x:Key="BtnPrimary"        Color="#1A56DB"/>   <!-- 흰 글씨 6.18:1 (AA) -->
    <SolidColorBrush x:Key="BtnPrimaryHover"   Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BtnPrimaryPressed" Color="#1E40AF"/>
    <!-- 끝난 일에 입히는 글씨색 (수집 완료·배포 완료·압축 완료). 학생 쪽 상태 글씨와 같은 값 -->
    <SolidColorBrush x:Key="DoneBlue"          Color="#1D4ED8"/>   <!-- 흰 바탕 6.70:1 (AA) -->

    <!-- 눌리지 않는 버튼. 예전 값(TextMuted)은 너무 진해 눌러도 되는 줄 알기 쉬웠다. -->
    <SolidColorBrush x:Key="BtnDisabled"   Color="#C8CCD2"/>
    <SolidColorBrush x:Key="Placeholder"   Color="#E4E5E7"/>
    <!-- 보안 경고. 미확인 글씨는 AlertRed, 경고를 담는 칸은 연붉은 AlertSoft 다 -->
    <SolidColorBrush x:Key="AlertRed"      Color="#C02020"/>
    <!-- 지우는 링크처럼 작은 글씨로 위험을 알릴 때. AlertRed 보다 진해 작게 써도 읽힌다 (7.77:1) -->
    <SolidColorBrush x:Key="AlertStrong"   Color="#A31818"/>

    <conv:DoneTextConverter x:Key="DoneText"/>
    <SolidColorBrush x:Key="AlertSoft"     Color="#FCE6E6"/>
    <!-- 중요 공지(상단바 가운데). 학생 앱 상단의 중요 공지와 같은 색이다 -->
    <SolidColorBrush x:Key="NoticeSoft"    Color="#FFFBEB"/>
    <SolidColorBrush x:Key="NoticeBorder"  Color="#FCD34D"/>
    <SolidColorBrush x:Key="NoticeLabel"   Color="#B45309"/>
    <SolidColorBrush x:Key="NoticeText"    Color="#78350F"/>

    <!-- ── 글자 크기 ──
         큰 제목(PageTitle)과 아이콘을 뺀 교수 화면의 모든 글자가 이 값을 쓴다.
         한꺼번에 키우거나 줄일 때는 여기만 고친다. 강의실 현황판은 창에 맞춰 스스로 늘어나므로 따로 둔다. -->
    <sys:Double x:Key="FontTiny">13</sys:Double>     <!-- 화면 모니터링 썸네일 위 작은 글자 -->
    <sys:Double x:Key="FontMini">14</sys:Double>     <!-- 메뉴 잠김 표시·배지·한 줄 오류 -->
    <sys:Double x:Key="FontSmall">15</sys:Double>    <!-- 라벨·캡션·표 머리글·체크박스 -->
    <sys:Double x:Key="FontBody">16</sys:Double>     <!-- 본문·버튼·입력칸·표 칸 -->
    <sys:Double x:Key="FontStrong">17</sys:Double>   <!-- 마법사 단계 이름·퀴즈 문제 번호 -->
    <sys:Double x:Key="FontSection">18</sys:Double>  <!-- 구역 제목·퀴즈 탭 -->
    <sys:Double x:Key="FontLarge">19</sys:Double>    <!-- 왼쪽 메뉴·상단 '교수용' -->
    <sys:Double x:Key="FontXLarge">21</sys:Double>   <!-- 학생 칸 이름·OX 보기 -->
    <sys:Double x:Key="FontKpi">30</sys:Double>      <!-- KPI 큰 숫자 -->

    <!-- ── 카드 ── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPage}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- KPI 카드: 라벨 + 큰 숫자 + (선택) 부제.
         좌우 여백은 1180 창에서 카드 7개가 한 줄에 설 때(시험 관리) 가장 긴 라벨 '시험 진행 중'이 한 줄에 들어가는 값이다 -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,16"/>
    </Style>

    <!-- ── 글자 ── -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSection}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontKpi}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="25"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- ── 버튼 ──
         모든 버튼은 크기·글자 크기·굵기가 같다. 화면마다 따로 키우거나 줄이지 않는다.
         옆 칸(입력칸 등)이 더 높아도 늘어나지 않도록 세로는 가운데에 둔다. -->
    <!-- 주요 버튼 — 그 화면에서 지금 해야 할 일 하나에만 쓴다.
         글자 크기·여백·모서리는 학생 프로그램 버튼과 같은 값으로 맞췄다. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BtnPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 보조 버튼 — 거드는 동작. 학생 프로그램의 검은 버튼과 같은 모양이다.
         주요 버튼(파랑)과는 색으로 무게를 가른다 — 파랑은 지금 해야 할 일 하나,
         검정은 그 밖의 누를 것. 올렸을 때 옅어지는 것도 학생 쪽과 같은 방식이다. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BtnDark}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 본문 안의 밑줄 링크 (브레드크럼, "전체 경고 내역 보기" 등) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="{StaticResource FontBody}"
                               Foreground="{StaticResource TextSecondary}"
                               TextDecorations="Underline"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 입력 ──
         고치거나 고를 수 있는 상자는 모두 검은 테두리다.
         읽기만 하는 상자(ReadOnlyBox)는 연한 테두리로 남겨 둘을 구분한다. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x2315;" FontSize="15" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="8,0,10,0"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 프로그램 이름을 넣는 상자. 오른쪽 돋보기가 [찾기] 버튼 몫을 한다(프로그램 목록에서 고르기).
         돋보기는 템플릿 안의 버튼이라 화면 코드가 직접 이름으로 못 잡는다.
         누른 신호가 상자까지 올라오므로 상자에 Button.Click 을 걸어 받는다. -->
    <Style x:Key="PickerBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" x:Name="PART_ContentHost" Margin="12,0,4,0"
                                          VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Focusable="False" Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="프로그램 목록에서 찾기"
                                    AutomationProperties.Name="프로그램 목록에서 찾기">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="30" Height="30">
                                            <Grid Width="16" Height="16">
                                                <Ellipse Width="11" Height="11" StrokeThickness="1.8"
                                                         Stroke="{StaticResource TextPrimary}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <Line X1="9.5" Y1="9.5" X2="15" Y2="15" StrokeThickness="2"
                                                      Stroke="{StaticResource TextPrimary}"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHeader}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 값을 보여 주기만 하는 상자. 돋보기도 검은 테두리도 없어 눌러 봐야 소용없음을 알린다 -->
    <Style x:Key="ReadOnlyBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 기본 콤보박스는 테두리 색을 테마가 정해 버려 BorderBrush 를 줘도 검게 되지 않는다.
         그래서 최소한의 틀을 직접 그린다. 편집 가능한 콤보(분류 입력)도 같은 틀을 쓴다. -->
    <Style x:Key="FilterCombo" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="White" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="6"/>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,32,0" VerticalAlignment="Center"/>

                        <!-- 편집 가능일 때만 보인다. 이름이 PART_EditableTextBox 여야 콤보가 값을 읽어 간다 -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="12,0,32,0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextPrimary}"/>

                        <!-- 편집 가능일 때는 화살표 자리만 눌리게 좁힌다. 안 그러면 글자를 찍을 수 없다 -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Path Data="M0,0 L9,0 L4.5,5.5 Z" Fill="{StaticResource TextPrimary}" IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                            <Border Background="White" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Toggle" Property="Width" Value="32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoteBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <!-- 체크박스도 테마 색을 벗겨내고 검은 네모로 통일한다 -->
    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" VerticalAlignment="Center"
                                Background="White" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.4">
                            <Path x:Name="Mark" Data="M0,3.4 L3.1,6.5 L8.6,0.6" Stroke="White" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BtnDark}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 아직 못 하는 일에 붙이는 한 줄. 왜 잠겼는지를 자물쇠와 함께 적는다 -->
    <Style x:Key="LockNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ── 표 ── 선 없는 납작한 표. 헤더만 회색 띠 -->
    <Style x:Key="TableHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TableRow" TargetType="ListViewItem">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 이 값이 기본(Left)이면 셀이 열 너비를 못 받아 내용만큼만 넓어진다.
             그러면 셀 안에서 가운데로 보내 봐야 왼쪽에 붙어 버린다. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                        <!-- 여백은 셀마다 준다. 행 전체에 주면 헤더와 기준점이 달라져 한 칸씩 어긋난다 -->
                        <GridViewRowPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFAFB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F2F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatTable" TargetType="ListView">
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TableRow}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- 칸 폭은 표 폭에 맞춰 늘고 준다. 가로 스크롤이 없으므로 넘치면 오른쪽 칸이 잘리기 때문이다 -->
        <Setter Property="common:TableDesign.FitColumns" Value="True"/>
        <!-- 기본 뼈대는 마우스를 올리거나 포커스를 받으면 테두리를 파랗게 덧그린다.
             평범한 Border 로 바꿔 위에서 정한 회색 테두리만 남긴다.
             모서리는 카드(Card)와 같은 둥글기이고, 안쪽은 테두리 두께만큼 작은 둥글기로 잘라
             머리글 회색 띠가 테두리에 딱 붙는다.
             ScrollViewer 에 GridView 전용 스타일을 줘야 열 머리글이 나온다. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                                      common:TableDesign.ClipRadius="7"
                                      Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 표 안의 셀 글자.
         헤더와 셀 모두 열 전체를 기준으로 가운데를 잡아야 세로로 줄이 맞는다.
         한쪽에만 여백을 주면 기준 상자가 달라져 중심이 어긋난다. -->
    <Style x:Key="Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- 칸을 가득 채운 뒤 글자를 가운데로 흘린다.
             HorizontalAlignment 로 상자를 가운데 두는 방식은 셀 컨테이너까지 닿지 않아
             왼쪽에 붙어 버린다. -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <!-- 칸보다 긴 글자는 뚝 잘리지 않고 … 으로 끝난다 -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 지우는 링크. 되돌릴 수 없는 동작이라 보기만 하는 링크와 색으로 갈라 둔다.
         밑줄은 그대로 둔다 — 색만으로 가르면 색을 못 가리는 사람이 알아채지 못한다.
         강조색(청록)은 '지금 눌러야 할 버튼' 몫으로 남겨 두고, 링크에는 위험 신호만 넣는다. -->
    <Style x:Key="DangerLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="{StaticResource FontBody}"
                               Foreground="{StaticResource AlertStrong}"
                               TextDecorations="Underline"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource AlertRed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 끝난 일만 파랗게. 같은 열에 '완료'와 '미수집'이 섞이므로 글자를 보고 고른다 -->
    <Style x:Key="CellStatus" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
        <Setter Property="Foreground"
                Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource DoneText}}"/>
    </Style>

    <Style x:Key="CaptionStatus" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground"
                Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource DoneText}}"/>
    </Style>

    <!-- 표 안의 링크(삭제 · 재배포 등) -->
    <Style x:Key="CellLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CellDangerLink" TargetType="Button" BasedOn="{StaticResource DangerLink}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 표 안의 체크박스 -->
    <Style x:Key="CellCheck" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 대시보드 학생 칸. 접속하면 초록, 접속 전·끊김은 빨강, 명단과 다르게 들어온 학생은 주황 테두리다 -->
    <SolidColorBrush x:Key="Good"          Color="#16A34A"/>
    <SolidColorBrush x:Key="GoodSoft"      Color="#F0FDF4"/>
    <SolidColorBrush x:Key="GoodBorder"    Color="#86EFAC"/>
    <SolidColorBrush x:Key="AlertBorder"   Color="#FCA5A5"/>
    <SolidColorBrush x:Key="WarnBorder"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarnText"      Color="#B45309"/>

    <!-- ── 학생 네모칸 현황 ──
         한 명이 한 칸이다. 표보다 자리를 많이 쓰지만 강의실을 훑듯이 볼 수 있어
         누가 빠졌는지 한눈에 들어온다. 미접속이면 칸 전체가 흐려진다. -->
    <Style x:Key="StudentCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="MinHeight" Value="104"/>
    </Style>

    <Style x:Key="StudentCardId" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StudentCardName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontXLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 칸 아래의 상태 배지. 접속 중이면 초록 띠, 미접속이면 빨간 띠(대시보드 칸 템플릿이 바꾼다) -->
    <Style x:Key="StudentCardBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{StaticResource Good}"/>
    </Style>

    <!-- ══ 창 제목줄 ══
         윈도가 그려 주던 제목줄을 우리가 직접 그린다.
         WindowChrome 은 그림만 넘겨받는 것이라 크기 조절·화면 가장자리에 붙이기·
         더블클릭 최대화 같은 창 동작은 전부 그대로 남는다.

         제목줄 안에 둔 누를 것에는 반드시 shell:WindowChrome.IsHitTestVisibleInChrome="True" 를 준다 —
         없으면 그 자리가 '끌어서 창 옮기기' 영역이라 눌림이 먹히지 않는다. -->

    <!-- 글리프는 윈도 기본 글꼴(Segoe MDL2 Assets)의 최소화·최대화·복원·닫기 기호다 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <!-- 이 기호 글꼴은 굵기가 한 가지라 FontWeight 가 먹지 않는다.
             획을 두껍게 하려면 글자를 조금 키우는 수밖에 없다 -->
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHeader}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 닫기만 빨갛게 반응한다. 잘못 누르면 되돌릴 수 없어 다른 둘과 구분해 둔다 -->
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter x:Name="Mark" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AlertRed}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 스스로 상단바를 가진 주 창(MainWindow)을 뺀 나머지 창이 쓴다.
         창 쪽에서는 Style="{DynamicResource AppWindow}" 한 줄만 주면 된다.
         (StaticResource 는 Window.Resources 보다 먼저 읽혀 찾지 못한다) -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="common:AppChrome.Managed" Value="True"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                                    CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- 최대화하면 윈도가 창을 테두리 두께만큼 화면 밖으로 내보낸다. 그만큼 안으로 들인다 -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="{Binding Path=(common:AppChrome.OutlineThickness), RelativeSource={RelativeSource TemplatedParent}}"
                            Margin="{Binding Path=(common:AppChrome.MaximizedPadding), RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="White">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Image Source="/Icon/Professor64.png" Width="18" Height="18" Margin="0,0,9,0"/>
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="{StaticResource FontSmall}"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                            ToolTip="최소화" AutomationProperties.Name="최소화"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                            ToolTip="최대화" AutomationProperties.Name="최대화"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                                            ToolTip="닫기" AutomationProperties.Name="닫기"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 풍선 도움말·입력 오류 표시가 뜨려면 AdornerDecorator 가 있어야 한다 -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 최대화된 창은 같은 버튼이 '이전 크기로'가 된다 -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Content" Value="&#xE923;"/>
                            <Setter TargetName="MaxButton" Property="ToolTip" Value="이전 크기로"/>
                            <Setter TargetName="MaxButton" Property="AutomationProperties.Name" Value="이전 크기로"/>
                            <Setter TargetName="MaxButton" Property="Command"
                                    Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                        </Trigger>
                        <!-- 크기를 바꿀 수 없는 창에는 최대화 버튼을 두지 않는다 -->
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
