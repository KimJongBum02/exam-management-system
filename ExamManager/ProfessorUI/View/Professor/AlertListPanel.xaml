<UserControl x:Class="ProfessorUI.View.Professor.AlertListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 부정행위 경고 목록. 시험 관리 화면과 알림·채팅 화면이 같은 모양을 쓰도록 한 벌만 둔다.
         화면의 DataContext(UiContext)에서 Overview.Alerts 를 읽는다.
         높이는 넣는 화면이 정한다 — 시험 관리는 옆 표와 같은 높이, 알림·채팅은 MaxHeight 로 몇 줄만.
         넘치면 이 안에서 넘긴다 -->
    <Border x:Name="Frame" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Overview.Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 시험 관리 화면에서는 절반 폭에 들어가므로 내용 칸이 남도록 좁게 잡는다 -->
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="136"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="State" Text="{Binding StateText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Who}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                                               ToolTip="{Binding Description}"/>
                                    <Button Grid.Column="4" Content="상세 확인" Style="{StaticResource LinkButton}"
                                            VerticalAlignment="Center" Click="AlertDetail_Click"/>
                                </Grid>
                            </Border>
                            <!-- 아직 보지 않은 경고는 굵은 붉은 글씨다 -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                    <Setter TargetName="State" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource AlertRed}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="아직 올라온 경고가 없습니다." Margin="18,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Overview.AlertCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
