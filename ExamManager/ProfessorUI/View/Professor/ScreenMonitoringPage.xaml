<UserControl x:Class="ProfessorUI.View.Professor.ScreenMonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProfessorUI.ViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="화면 모니터링" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding StudentCountText}"
                       Style="{StaticResource Caption}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ── 학생 없을 때 안내 ── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="40"
                Visibility="{Binding HasNoStudents, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="접속 중인 학생이 없습니다."
                           Style="{StaticResource Body}"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="학생이 접속하면 화면이 자동으로 표시됩니다."
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 썸네일 그리드 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TileList" ItemsSource="{Binding Students}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StudentScreenItem}">
                        <!-- 클릭 가능한 타일 -->
                        <Button Width="256" Height="196" Margin="8"
                                Click="Tile_Click" Tag="{Binding}"
                                Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TileBorder"
                                            Background="#1F2328" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderLight}">
                                        <Grid>
                                            <!-- 화면 이미지 -->
                                            <Image Source="{Binding Screen}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="LowQuality"/>

                                            <!-- 수신 전 플레이스홀더 -->
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding HasScreen, Converter={StaticResource BoolToVis}}">
                                            </StackPanel>
                                            <TextBlock Text="대기 중…" Foreground="#888"
                                                       FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasScreen}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 하단 학생 정보 바 -->
                                            <Border VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                                                    Padding="10,6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#CC000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="White" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastUpdated}"
                                                               Foreground="#AAAAAA" FontSize="10"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileBorder" Property="BorderBrush"
                                                    Value="{StaticResource BtnDark}"/>
                                            <Setter TargetName="TileBorder" Property="BorderThickness"
                                                    Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
