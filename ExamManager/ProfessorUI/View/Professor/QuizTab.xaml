<UserControl x:Class="ProfessorUI.View.Professor.QuizTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 탭. 고른 쪽만 굵은 글씨와 밑줄로 남긴다 -->
            <Style x:Key="TabButton" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,26,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="0,0,0,3" Padding="2,0,2,9">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="{StaticResource FontSection}"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- 제목 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="퀴즈" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 채점하는 수업 확인 퀴즈와 정답 없는 설문을 탭으로 나눈다 -->
        <Border BorderBrush="{StaticResource Placeholder}" BorderThickness="0,0,0,1" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="QuizButton" Content="수업 확인 퀴즈" Style="{StaticResource TabButton}"
                             GroupName="QuizKind" Checked="Tab_Checked"/>
                <RadioButton x:Name="SurveyButton" Content="설문" Style="{StaticResource TabButton}"
                             GroupName="QuizKind" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="TabHost"/>
    </StackPanel>
</UserControl>
