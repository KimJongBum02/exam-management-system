<Window x:Class="ProfessorUI.View.Professor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:ProfessorUI.Common"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shared="clr-namespace:ExamManager.Shared"
        Title="시험 운영"
        Icon="/Assets/YUHAN.ico"
        Background="#FFFFFF"
        common:AppChrome.Managed="True">

    <!-- 제목줄을 따로 두지 않고 아래 상단바가 그 자리를 그대로 쓴다.
         CaptionHeight 를 상단바 높이(56)에 맞춰야 빈 곳을 끌어 창을 옮길 수 있다. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 상단바 가운데의 중요 공지 칸. 공지가 있으면 노란 띠에 문구가, 없으면 흰 띠에 [중요 공지 등록]이 보인다.
                 어느 쪽이든 누르면 등록·수정·내리기 창이 뜬다 -->
            <Style x:Key="ImportantNoticeChip" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTip" Value="학생 앱과 교수 앱 상단 가운데에 계속 보이는 공지를 등록합니다"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd" CornerRadius="17" Padding="16,6" BorderThickness="1"
                                        Background="White" BorderBrush="{StaticResource BorderLight}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <!-- 마우스를 올리면 띠 전체를 살짝 어둡게 한다. 노란 띠·흰 띠 어느 쪽에도 같이 먹는다 -->
                                <Border x:Name="Hover" CornerRadius="17" Background="#0F000000"
                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Chat.HasImportantNotice}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NoticeSoft}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NoticeBorder}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 길어서 … 으로 줄어든 공지도 마우스를 올리면 전체가 보인다 -->
                    <DataTrigger Binding="{Binding Chat.HasImportantNotice}" Value="True">
                        <Setter Property="ToolTip" Value="{Binding Chat.ImportantNotice}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단바 ── 왼쪽 제목 · 가운데 중요 공지 · 오른쪽 메뉴. 공지는 창 한가운데에 놓인다(HeaderBarPanel) -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <shared:HeaderBarPanel Height="56">
                <!-- 위쪽 여백으로 상단바 내용을 조금 아래로 내린다 (가운데 정렬이라 여백의 절반만큼 내려간다) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,8,0,0">
                    <Image Source="/Assets/YUHAN.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="교수용" FontSize="{StaticResource FontLarge}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 가운데: 중요 공지. 학생 앱 상단 가운데에도 같은 문구가 뜬다.
                     제목줄 안이라 IsHitTestVisibleInChrome 이 있어야 눌린다. 위 여백 8 은 양옆과 높이를 맞춘다 -->
                <Button Style="{StaticResource ImportantNoticeChip}" Click="ImportantNotice_Click" Margin="0,8,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontSize="{StaticResource FontSmall}" FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x1F4E2; 중요 공지 등록"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Chat.HasImportantNotice}" Value="True">
                                            <Setter Property="Text" Value="&#x1F4E2; 중요 공지"/>
                                            <Setter Property="Foreground" Value="{StaticResource NoticeLabel}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Chat.ImportantNotice}" FontSize="{StaticResource FontBody}"
                                   Foreground="{StaticResource NoticeText}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Chat.HasImportantNotice, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </Button>
                <!-- 오른쪽: 메뉴와 창 단추를 한 덩어리로 둔다. 공지 칸은 이 덩어리와 겹치지 않는 데까지만 가운데에 놓인다 -->
                <StackPanel Orientation="Horizontal">
                    <!-- 제목줄 안이라 누를 것에는 IsHitTestVisibleInChrome 이 있어야 눌린다 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,8,16,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- 마지막 갱신과 서버 상태. 어느 화면에 있어도 보이도록 상단바에 둔다.
                             서버 상태에는 학생 접속 주소가 붙어 있어 여기서 바로 불러 줄 수 있다 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Run Text="마지막 갱신:"/><Run Text=" "/><Run Text="{Binding Overview.LastUpdatedText, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- 학생을 실제로 받을 수 있으면 초록, 아니면 빨강 (몇 초마다 다시 확인한다) -->
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AlertRed}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Server.IsHealthy}" Value="True">
                                            <Setter Property="Fill" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Server.StatusText, Mode=OneWay}" FontSize="{StaticResource FontBody}"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <!-- 꺼졌을 때만 보인다. 같은 포트로 서버만 다시 연다(학생 목록·기록은 그대로) -->
                        <Button Content="서버 다시 열기" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0"
                                Command="{Binding Server.RestartCommand}"
                                Visibility="{Binding Server.IsDown, Converter={StaticResource BoolToVis}}"/>
                        <!-- 강의실 PC 가 9000번을 이미 쓰고 있을 때 여기서 포트를 바꾼다 -->
                        <Button x:Name="PortButton" Content="포트 변경" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0"
                                Click="PortButton_Click"/>
                    </StackPanel>

                    <!-- 창 단추. 제목줄이 없어진 자리를 대신한다.
                         닫기는 압축·전송 중인지 확인하는 기존 종료 절차를 그대로 탄다
                         (그래서 따로 있던 '종료' 버튼은 없앴다). -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"
                                Margin="0,4,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Height="52" Content="&#xE921;"
                                ToolTip="최소화" AutomationProperties.Name="최소화"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Height="52" Content="&#xE922;"
                                ToolTip="최대화" AutomationProperties.Name="최대화" Click="MaxRestore_Click"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Height="52" Content="&#xE8BB;"
                                ToolTip="종료" AutomationProperties.Name="종료" Click="ExitButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </shared:HeaderBarPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 운영 메뉴 ── -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,26,16,0">
                    <TextBlock Text="운영 메뉴" Style="{StaticResource Caption}" Margin="12,0,0,14"/>
                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="MenuList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <!-- 메뉴 사이를 넉넉히 띄운다 -->
                                <Setter Property="Padding" Value="12,12"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- 시험 단계가 허락하지 않는 메뉴는 아예 눌리지 않는다 -->
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                                <!-- 항목이 문자열이 아니라 객체라, 읽어 줄 이름을 따로 지정한다 -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="ToolTip" Value="{Binding LockReason}"/>
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E3E5E9"/>
                                                </Trigger>
                                                <!-- 지금 보고 있는 메뉴는 검은 바탕에 교표 청록 띠를 두른다 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDark}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BtnPrimary}"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 메뉴 글씨는 모두 검은색이다. 보고 있는 메뉴만 흰 글씨로 뒤집는다 -->
                                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="{StaticResource FontLarge}"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="Lock" Text="&#x1F512; 잠김" FontSize="{StaticResource FontMini}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                               Visibility="Collapsed"/>
                                    <!-- 처리할 것이 쌓인 개수. 학생 화면의 채팅 배지와 같은 모양을 빨간색으로 쓴다 -->
                                    <Border Background="{StaticResource AlertRed}" CornerRadius="11" Height="22" MinWidth="22"
                                            Padding="6,0" Margin="9,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BadgeCount}" FontSize="{StaticResource FontMini}" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ── 페이지 ── -->
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" Margin="30,26,30,30"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
