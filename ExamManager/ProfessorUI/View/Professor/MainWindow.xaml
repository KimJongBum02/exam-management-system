<Window x:Class="ProfessorUI.View.Professor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시험 운영" Height="960" Width="1480"
        WindowState="Maximized" MinHeight="720" MinWidth="1180"
        Background="#FFFFFF"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단바 ── -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <Grid Height="56" Margin="26,0">
                <TextBlock Text="시험 운영" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 마지막 갱신과 서버 상태. 어느 화면에 있어도 보이도록 상단바에 둔다.
                         서버 상태에는 학생 접속 주소가 붙어 있어 여기서 바로 불러 줄 수 있다 -->
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Run Text="마지막 갱신:"/><Run Text=" "/><Run Text="{Binding Overview.LastUpdatedText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center">
                        <Run Text="● 서버"/><Run Text=" "/><Run Text="{Binding Server.StatusText, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- 강의실 PC 가 9000번을 이미 쓰고 있을 때 여기서 포트를 바꾼다 -->
                    <Button x:Name="PortButton" Content="포트 변경" Style="{StaticResource SecondaryButton}"
                            FontSize="12" Padding="12,6" Margin="10,0,0,0"
                            Click="PortButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 운영 메뉴 ── -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,26,16,0">
                    <TextBlock Text="운영 메뉴" Style="{StaticResource Caption}" Margin="12,0,0,14"/>
                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="MenuList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <!-- 메뉴 사이를 넉넉히 띄운다 -->
                                <Setter Property="Padding" Value="12,12"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- 시험 단계가 허락하지 않는 메뉴는 아예 눌리지 않는다 -->
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                                <!-- 항목이 문자열이 아니라 객체라, 읽어 줄 이름을 따로 지정한다 -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="ToolTip" Value="{Binding LockReason}"/>
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E3E5E9"/>
                                                </Trigger>
                                                <!-- 지금 보고 있는 메뉴는 검은 바탕이다 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDark}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 메뉴 글씨는 모두 검은색이다. 보고 있는 메뉴만 흰 글씨로 뒤집는다 -->
                                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="16"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="Lock" Text="&#x1F512; 잠김" FontSize="11" Margin="9,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ── 페이지 ── -->
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" Margin="30,26,30,30"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
