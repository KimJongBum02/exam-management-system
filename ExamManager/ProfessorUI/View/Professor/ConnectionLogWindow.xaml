<Window x:Class="ProfessorUI.View.Professor.ConnectionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="학생 접속 기록" Height="660" Width="900"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Style="{DynamicResource AppWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="학생 접속 기록" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="학생이 접속할 때마다 한 줄씩 쌓입니다. 끊겼다 다시 들어오면 재접속으로 남으므로, 같은 학생이 여러 줄 보이면 그 자리의 랜선이나 PC 를 확인해 보세요."/>

        <ListView Grid.Row="2" x:Name="LogTable" Style="{StaticResource FlatTable}">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                    <GridViewColumn Header="시각" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding TimeText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="구분" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding KindText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="학번" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="이름" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="IP" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Ip}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 기록이 없을 때. 빈 표만 두면 고장인지 아직 아무도 안 온 것인지 알 수 없다 -->
        <TextBlock Grid.Row="2" x:Name="EmptyNote" Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   Text="아직 접속한 학생이 없습니다. 학생이 접속하면 이 자리에 한 줄씩 쌓입니다."/>

        <Button Grid.Row="3" Content="닫기" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
    </Grid>
</Window>
