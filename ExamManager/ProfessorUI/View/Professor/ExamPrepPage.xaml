<UserControl x:Class="ProfessorUI.View.Professor.ExamPrepPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 점검 항목 한 줄: ● 이름 ......... 상태 -->
            <Style x:Key="CheckRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,11"/>
            </Style>

            <!-- 프로세스 목록 한 줄: 이름 + 삭제 -->
            <DataTemplate x:Key="ProcessRowTemplate">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="{Binding}" Style="{StaticResource Cell}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="시험 준비 마법사" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="18,0,14,3">
                <Run Text="마지막 갱신:"/><Run Text=" "/><Run Text="{Binding Overview.LastUpdatedText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,3">
                <Run Text="● 서버"/><Run Text=" "/><Run Text="{Binding Server.StatusText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- 4단계 스텝퍼 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
            <Border x:Name="Step1Box" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="1단계" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                    <TextBlock x:Name="Step1Name" Text="시험 준비" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
            <Border x:Name="Step2Box" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="2단계" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                    <TextBlock x:Name="Step2Name" Text="서버 열기" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
            <Border x:Name="Step3Box" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="3단계" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                    <TextBlock x:Name="Step3Name" Text="파일 배포" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
            <Border x:Name="Step4Box" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="4단계" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                    <TextBlock x:Name="Step4Name" Text="시험 시작" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">

            <!-- ═══ 1단계: 시험 준비 — 파일 암호화·압축 + 허용/금지 프로세스 ═══ -->
            <Grid x:Name="Step1Panel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="준비 상태 안내" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="현재 단계: 시험 파일 및 보안 정책 준비" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="배포할 시험 파일을 지정하면 암호화·압축된 배포용 파일이 생성됩니다. 학생이 접속하기 전에 끝내 두는 단계입니다."/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="허용·금지 프로세스 목록은 시험 시작 시 학생 PC에 함께 전달됩니다. 시험 중에도 보안 정책 화면에서 변경할 수 있습니다."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="시험 파일 선택" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="시험 파일" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" IsReadOnly="True"
                                         Foreground="{StaticResource TextPrimary}"
                                         Text="{Binding FileReady.SelectedFilesSummary, Mode=OneWay}"/>
                                <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" Command="{Binding FileReady.SelectFilesCommand}"/>
                            </Grid>

                            <!-- 고른 파일 이름들. 여러 개를 묶어 하나로 압축한다 -->
                            <ItemsControl ItemsSource="{Binding FileReady.SelectedFileNames}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="암호화·압축 상태" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding FileReady.CurrentStatusMessage}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="진행률" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding FileReady.ProgressText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Button Content="암호화·압축 실행" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Command="{Binding FileReady.StartProcessCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="금지 프로세스 목록" Style="{StaticResource SectionTitle}"/>
                            <Button Content="전체 삭제" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding BlackList.ClearAllCommand}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Text="{Binding BlackList.InputProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="목록에서 찾기" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="PickBlack_Click"/>
                            <Button Grid.Column="2" Content="추가" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Command="{Binding BlackList.AddCommand}"/>
                        </Grid>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding BlackList.BlackList}"
                              Style="{StaticResource FlatTable}" MinHeight="150">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                                <GridViewColumn Header="프로세스 이름" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="관리" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="삭제" Style="{StaticResource CellLink}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.BlackList.RemoveCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,20,0,10">
                        <Grid>
                            <TextBlock Text="허용 프로세스 목록" Style="{StaticResource SectionTitle}"/>
                            <Button Content="전체 삭제" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding WhiteList.ClearAllCommand}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Text="{Binding WhiteList.InputProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="목록에서 찾기" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="PickWhite_Click"/>
                            <Button Grid.Column="2" Content="추가" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Command="{Binding WhiteList.AddCommand}"/>
                        </Grid>
                    </StackPanel>

                    <ListView Grid.Row="3" ItemsSource="{Binding WhiteList.WhiteList}"
                              Style="{StaticResource FlatTable}" MinHeight="150">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                                <GridViewColumn Header="프로세스 이름" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="관리" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="삭제" Style="{StaticResource CellLink}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.WhiteList.RemoveCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button Grid.Row="4" Content="다음: 서버 열기 단계로 이동" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,20,0,0" Click="GoStep2_Click"/>
                </Grid>
            </Grid>

            <!-- ═══ 2단계: 학생 접속 — 서버 열기 + 접속 현황 ═══ -->
            <Grid x:Name="Step2Panel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="학생 접속 안내" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="현재 단계: 서버 열기 및 학생 접속 대기" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="서버를 열면 학생이 아래 주소로 접속할 수 있습니다. 학생에게 주소를 안내하십시오."/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="접속한 학생의 상태가 모두 파악되면 다음 단계(파일 배포)로 이동할 수 있습니다."/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="지각생이 있을 경우 일부 학생만 접속된 상태로 다음 단계로 이동할 수 있으나, 미접속 학생은 이후 재배포를 통해 합류해야 합니다."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="서버 상태" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- 학생에게 불러 줘야 하는 값이라 이 화면에서 제일 크게 둔다 -->
                            <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="학생 접속 주소" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Server.Address}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="학생 프로그램의 접속 화면에 이 주소를 그대로 입력하게 하십시오."
                                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="서버 상태" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Server.StatusText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="서버 열기" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        Command="{Binding Server.StartCommand}"/>
                                <Button Content="서버 닫기" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Server.StopCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="학생 접속 현황" Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="전체" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.TotalCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="접속 완료" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.ConnectedCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="미접속" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.NotConnectedCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ListView Grid.Row="2" x:Name="ConnectTable" Style="{StaticResource FlatTable}" MinHeight="260">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                                <GridViewColumn Header="학번" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="이름" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="접속 상태" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="접속 시각" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding LastUpdate}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="미접속 학생이 있어도 다음 단계로 이동할 수 있습니다. 늦게 온 학생은 시험 관리 창에서 재배포로 합류시킵니다."/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="이전: 시험 준비 단계" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="GoStep1_Click"/>
                        <Button Content="다음: 파일 배포 단계로 이동" Style="{StaticResource PrimaryButton}" Click="GoStep3_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ 3단계: 파일 배포 ═══ -->
            <Grid x:Name="Step3Panel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="파일 배포 안내" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="현재 단계: 시험 파일 일괄 배포" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="접속한 학생에게만 시험 파일이 전송됩니다. 미접속 학생은 배포 대상에서 제외됩니다."/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="같은 학생에게 두 번 보내지 않으므로, 실패한 학생만 남은 상태에서 다시 눌러도 안전합니다."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="배포 진행 상태" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="접속 중인 학생" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.ConnectedCount}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="수신 완료" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.FileReceivedCount}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="아직 못 받은 학생" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.FileMissingCount}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding Distribute.DeployStatusMessage}" Style="{StaticResource Caption}"
                                       Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Distribute.ValidationMessage}" Style="{StaticResource Body}"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="파일 일괄 배포 시작" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        Command="{Binding Distribute.StartDeployCommand}"/>
                                <Button Content="전체 선택" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding Distribute.SelectAllCommand}"/>
                                <Button Content="전체 해제" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Distribute.DeselectAllCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="학생별 다운로드 상태" Style="{StaticResource SectionTitle}"/>
                    <ListView Grid.Row="1" x:Name="DownloadTable" Style="{StaticResource FlatTable}" MinHeight="340">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                                <GridViewColumn Header="대상" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource CellCheck}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="학번" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="이름" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="전송 상태" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource Cell}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="진행률" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Cell}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="전송 실패 학생이 남아 있어도 다음 단계로 이동할 수 있습니다. 시험 관리 창에서 다시 배포하십시오."/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="이전: 서버 열기 단계" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="GoStep2_Click"/>
                        <Button Content="다음: 시험 시작 단계로 이동" Style="{StaticResource PrimaryButton}" Click="GoStep4_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ 4단계: 시험 시작 ═══ -->
            <Grid x:Name="Step4Panel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="시험 시작 안내" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="현재 단계: 시험 시작 실행" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="시험 시작을 실행하면 허용·금지 프로세스 목록이 먼저 전달되고, 이어서 시험 시작 신호와 압축 해제 요청이 전송됩니다."/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="시작 이후에는 시험 관리 창에서 학생 상태, 부정행위 경고, 채팅, 재배포를 처리합니다."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="최종 점검" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CheckRow}">
                                <TextBlock Text="● 시험 파일 암호화·압축" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding FileReady.CurrentStatusMessage}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource CheckRow}">
                                <TextBlock Text="● 허용 프로세스" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding WhiteList.WhiteList.Count}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource CheckRow}">
                                <TextBlock Text="● 금지 프로세스" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding BlackList.BlackList.Count}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource CheckRow}">
                                <TextBlock Text="● 학생 접속" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.ConnectedText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource CheckRow}">
                                <TextBlock Text="● 파일 수신 완료" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.FileReceivedCount}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0">
                                <TextBlock Text="● 네트워크 감시" Style="{StaticResource Body}"/>
                                <TextBlock Text="{Binding Overview.NetworkMonitorText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="시작 대상 요약" Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="파일 수신" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.FileReceivedCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="파일 미수신" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.FileMissingCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="미접속" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Overview.NotConnectedCount}" Style="{StaticResource KpiValue}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <TextBlock Text="명" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource BgSubtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8"
                                       Text="시험 시작 후 합류하는 학생은 시험 관리 창의 파일 재배포로 처리합니다."/>
                            <TextBlock x:Name="StartHint" Style="{StaticResource Caption}"
                                       Text="파일 배포를 한 번이라도 실행해야 시험을 시작할 수 있습니다."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="이전: 파일 배포 단계" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="GoStep3_Click"/>
                        <Button x:Name="StartExamButton" Content="시험 시작 실행" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding ExamStart.IsStartButtonEnabled}" Click="StartExam_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
