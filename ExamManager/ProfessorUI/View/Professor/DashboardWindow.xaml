<UserControl x:Class="ProfessorUI.View.Professor.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProfessorUI.View.Professor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 학생 칸의 말풍선. 누르면 그 학생과의 1:1 대화가 바로 열린다 -->
            <Style x:Key="ChatBubble" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="이 학생과 1:1 채팅"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock Text="&#x1F4AC;" FontSize="16" FontFamily="Segoe UI Emoji"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtle}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목과 이동 버튼을 한 줄에 둔다. 버튼을 찾으려고 화면 끝까지 내려가지 않아도 된다 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:BackButton/>
                <TextBlock Text="실시간 학생 현황" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="강의실 현황판 열기" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="OpenMonitorBoard_Click"/>
                <Button Content="시험 준비 화면으로 이동" Style="{StaticResource PrimaryButton}"
                        Click="StartWizard_Click"/>
            </StackPanel>
        </Grid>

        <!-- 한 명이 한 칸. 강의실을 훑듯이 훑어 누가 빠졌는지 바로 찾는다.
             Top 으로 붙이지 않으면 UniformGrid 가 남는 세로 공간을 행마다 나눠 가져
             학생이 적을 때 칸이 우스꽝스럽게 길어진다. -->
        <ItemsControl Grid.Row="1" x:Name="StudentCards" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="CardBox" Style="{StaticResource StudentCard}">
                        <Grid>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock x:Name="IdText" Text="{Binding StudentId}" Style="{StaticResource StudentCardId}"/>
                                <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource StudentCardName}"
                                           Margin="0,0,0,10"/>
                                <Border x:Name="Badge" Style="{StaticResource StudentCardBadge}" Margin="0,0,0,7">
                                    <TextBlock x:Name="BadgeText" Text="{Binding ConnectionText}" FontSize="11.5"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Style="{StaticResource ChatBubble}" Click="Chat_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <!-- 미접속이면 칸 전체를 흐리게 해 접속한 학생 사이에서 눈에 띄게 한다 -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter TargetName="CardBox" Property="Background" Value="{StaticResource BgSubtle}"/>
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Placeholder}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 학생이 한 명도 붙지 않았을 때. 빈 화면만 두면 고장인지 대기인지 알 수 없다 -->
        <TextBlock Grid.Row="1" x:Name="EmptyNote" Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed"
                   Text="아직 접속한 학생이 없습니다. 학생이 접속하면 이 자리에 한 명씩 나타납니다."/>
    </Grid>
</UserControl>
