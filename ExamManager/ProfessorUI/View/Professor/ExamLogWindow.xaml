<UserControl x:Class="ProfessorUI.View.Professor.ExamLogWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProfessorUI.View.Professor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 부정행위가 없는 학생 줄에는 내역 상자를 아예 띄우지 않는다 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- 부정행위 내역은 건수만큼 줄이 늘어난다. 다른 표와 달리 행 높이를 고정하지 않는다 -->
            <Style x:Key="LogRow" TargetType="ListViewItem" BasedOn="{StaticResource TableRow}">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="42"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목과 내보내기 버튼을 한 줄에 둔다 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:BackButton/>
                <TextBlock Text="시험 로그" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="엑셀로 저장" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="SaveExcel_Click"/>
        </Grid>

        <!-- 한눈에 보는 수 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="전체 학생" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ExamLog.TotalCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="출석" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ExamLog.AttendedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="부정행위 적발" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ExamLog.CheatedCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="출석은 시험에 접속해 시험을 시작한 기록으로 판단합니다. 부정행위 횟수는 금지 프로그램 실행처럼 학생 PC 가 실제로 막은 건만 셉니다 — 허용 프로그램을 닫은 기록이나 감시 확인 경고는 세지 않습니다."/>

        <ListView Grid.Row="3" x:Name="LogTable" Style="{StaticResource FlatTable}" MinHeight="420"
                  ItemContainerStyle="{StaticResource LogRow}"
                  ItemsSource="{Binding ExamLog.Rows}">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}">
                    <GridViewColumn Header="학번" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding StudentId}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="이름" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="출석 여부" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding AttendanceText}" Style="{StaticResource Cell}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="부정행위 횟수" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CheatCount}" Style="{StaticResource Cell}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- 부정행위를 한 학생만 무엇을 했는지 옆에 적힌다.
                         한 건이 아닐 수 있어 줄을 나눠 모두 보여 준다 -->
                    <GridViewColumn Header="부정행위 내용" Width="620">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AlertSoft}" CornerRadius="4"
                                        Padding="10,6" Margin="6,4" HorizontalAlignment="Stretch"
                                        Visibility="{Binding HasCheated, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding CheatDetail}" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
