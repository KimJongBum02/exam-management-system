<UserControl x:Class="ProfessorUI.View.Professor.BackButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 화면 제목 왼쪽에 붙는 뒤로가기.
         갈 곳이 있으면 검은 바탕, 없으면 흐려져 눌리지 않는다. -->
    <Button x:Name="Button" Click="Back_Click" Cursor="Hand"
            VerticalAlignment="Center" Margin="0,0,10,0"
            ToolTip="이전 화면으로"
            AutomationProperties.Name="이전 화면으로">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Width="32" Height="32" CornerRadius="6"
                        Background="{StaticResource BtnDark}"
                        BorderBrush="{StaticResource BtnDark}" BorderThickness="1.2">
                    <TextBlock x:Name="Arrow" Text="&#x2190;" FontSize="17"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnDarkHover}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BtnDarkHover}"/>
                    </Trigger>
                    <!-- 뒤로 갈 곳이 없을 때. 테두리와 화살표를 함께 흐려 눌러도 소용없음을 알린다 -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Placeholder}"/>
                        <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Placeholder}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
