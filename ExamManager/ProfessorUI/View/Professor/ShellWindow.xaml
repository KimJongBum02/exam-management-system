<Window x:Class="ProfessorUI.View.Professor.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시험 운영" Height="960" Width="1480"
        WindowState="Maximized" MinHeight="720" MinWidth="1180"
        Background="#FFFFFF"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProfessorUI;component/View/Professor/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단바 ── -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <Grid Height="56" Margin="26,0">
                <TextBlock Text="시험 운영" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 서버 연결 상태. 어느 화면에 있어도 보이도록 상단바에 둔다 -->
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,22,0" VerticalAlignment="Center">
                        <Run Text="● 서버"/><Run Text=" "/><Run Text="{Binding Server.StatusText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 알림. 다른 화면에 있을 때 경고·채팅이 왔음을 알리는 유일한 자리라 개수를 함께 띄운다 -->
                    <Button x:Name="NotifyButton" Click="ToggleNotifyPane_Click" Cursor="Hand"
                            Margin="0,0,22,0" VerticalAlignment="Center"
                            AutomationProperties.Name="알림">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <TextBlock Text="알림" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" TextDecorations="Underline"/>
                                    <Border x:Name="Badge" Background="{StaticResource BtnDark}" CornerRadius="9"
                                            MinWidth="18" Height="18" Padding="6,0" Margin="7,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Foreground="White"
                                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <!-- 알릴 것이 없으면 배지를 숨긴다 -->
                                    <Trigger Property="Tag" Value="0">
                                        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="프로필" FontSize="13" Foreground="{StaticResource TextPrimary}"
                               TextDecorations="Underline" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 운영 메뉴 ── -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                <StackPanel Margin="26,26,0,0">
                    <TextBlock Text="운영 메뉴" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="MenuList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="0,7"/>
                                <!-- 시험 단계가 허락하지 않는 메뉴는 아예 눌리지 않는다 -->
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                                <!-- 항목이 문자열이 아니라 객체라, 읽어 줄 이름을 따로 지정한다 -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="ToolTip" Value="{Binding LockReason}"/>
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="14.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextDecorations="Underline"/>
                                    <TextBlock x:Name="Lock" Text="잠김" FontSize="11" Margin="9,0,0,0"
                                               VerticalAlignment="Center" Foreground="#C4C7CC"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Label" Property="Foreground" Value="#C4C7CC"/>
                                        <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}"/>
                                        <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ── 페이지 ── -->
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" Margin="30,26,30,30"/>
            </ScrollViewer>

            <!-- ── 알림 패널 ── 어느 화면에 있든 경고와 채팅을 화면 이동 없이 확인한다 -->
            <Border x:Name="NotifyPane" Grid.Column="2" Width="390" Visibility="Collapsed"
                    Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1,0,0,0">
                <Grid Margin="22,24,22,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="알림" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button Content="닫기" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="ToggleNotifyPane_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="PaneAlertTitle" Text="부정행위 경고"
                               Style="{StaticResource SectionTitle}"/>

                    <ItemsControl Grid.Row="2" x:Name="PaneAlertList" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Who}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,9" TextWrapping="Wrap">
                                            <Run Text="{Binding Description, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Time, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Content="상세 확인" Style="{StaticResource LinkButton}"
                                                Click="PaneAlertDetail_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="3" x:Name="PaneChatTitle" Text="학생 채팅"
                               Style="{StaticResource SectionTitle}" Margin="0,14,0,10"/>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PaneChatList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SenderName}" FontSize="12.5"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="5" Margin="0,14,0,0">
                        <TextBlock Text="전체 학생에게 공지" Style="{StaticResource FieldLabel}"/>
                        <TextBox Height="72" Style="{StaticResource NoteBox}"
                                 Foreground="{StaticResource TextPrimary}"
                                 Text="{Binding Chat.InputMessage, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="전송" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Chat.SendMessageCommand}"
                                HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
