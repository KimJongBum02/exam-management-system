<UserControl x:Class="ProfessorUI.View.NotificationView.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext는 지정하지 않는다.
         MainWindow의 DataTemplate이 NotificationViewModel을 넣어 주므로 그대로 물려받는다.
         (이전에는 존재하지 않는 NotificationVM을 찾도록 되어 있어 화면이 비어 있었다) -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="🔔 부정행위 알림" FontSize="16" FontWeight="Bold" Foreground="#EF4444"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Button Content="전체 지우기" Command="{Binding ClearCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                        FontSize="12" Cursor="Hand"
                        Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- 알림이 없을 때 -->
        <TextBlock Grid.Row="1" Text="새로운 알림이 없습니다." Foreground="#94A3B8"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 최근 알림이 위로 온다 (AlertStore가 앞에 넣는다) -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Alerts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Who}" FontSize="13" FontWeight="Bold"
                                               Foreground="#B91C1C" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#94A3B8"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#475569"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
