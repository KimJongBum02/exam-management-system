<UserControl x:Class="ProfessorUI.View.ExamFlowView.ExamFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 동그라미에 마우스를 올렸을 때 뜨는 단계 이름 -->
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 이전/다음 버튼 공통 골격.
             색은 반드시 아래 파생 스타일의 Setter로 준다 — 버튼 태그에 직접 쓰면
             그 값이 '로컬 값'이 되어 비활성화 트리거를 이겨 버린다. -->
        <Style x:Key="NavButtonBase" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPrevButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A56DB"/>
            <Setter Property="BorderBrush" Value="#BFD0F5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NavNextButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
            <Setter Property="Background" Value="#1A56DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A56DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 미니 단계 표시 ──────────────────────────────────────────────
             동그라미를 선으로 이어 놓은 진행 막대. 지금 단계에만 색이 들어온다.
             마우스를 올리면 단계 이름이 뜨고, 누르면 그 단계로 바로 옮겨 간다. -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Steps}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!-- 앞 단계와 이어 주는 선 (첫 단계에는 없다) -->
                        <Border Width="52" Height="2" Background="#DDE3EA" VerticalAlignment="Center"
                                Visibility="{Binding HasConnector, Converter={StaticResource BoolToVis}}"/>

                        <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}"
                                ToolTipService.InitialShowDelay="120"
                                ToolTipService.Placement="Top"
                                Cursor="Hand" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Dot" Width="26" Height="26" CornerRadius="13"
                                            Background="White" BorderBrush="#CBD5E1" BorderThickness="2">
                                        <TextBlock x:Name="Num" Text="{Binding Number}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#94A3B8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="#E8EDF5"/>
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="#94A3B8"/>
                                        </Trigger>
                                        <!-- 지금 보고 있는 단계 — 사이드바 선택 색과 같은 색 -->
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="#1A56DB"/>
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="#1A56DB"/>
                                            <Setter TargetName="Num" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── 단계 본문 ───────────────────────────────────────────────────
             MaxWidth는 단계마다 다르다. 좁은 값이 들어오면 WPF가 가운데로 놓아 준다. -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentStep.Content}"
                        MaxWidth="{Binding CurrentStep.ContentMaxWidth}"
                        Margin="0,20,0,0"/>

        <!-- ── 이전 / 다음 ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="← 이전" Command="{Binding PreviousCommand}"
                    Style="{StaticResource NavPrevButton}" Margin="0,0,10,0"/>

            <Button Content="다음 →" Command="{Binding NextCommand}"
                    Style="{StaticResource NavNextButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
