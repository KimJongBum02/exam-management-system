<UserControl x:Class="ProfessorUI.View.DashBoardCardView.DashBoardCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid HorizontalAlignment="Stretch" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="85"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelStyle">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="ValueStyle">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="총 학생" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding TotalStudents}" Style="{StaticResource ValueStyle}" Foreground="#1E293B"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="접속" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding ConnectedStudents}" Style="{StaticResource ValueStyle}" Foreground="#2563EB"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="진행 중" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding ProgressStudents}" Style="{StaticResource ValueStyle}" Foreground="#059669"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="부정행위" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding CheatStudents}" Style="{StaticResource ValueStyle}" Foreground="#DC2626"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>