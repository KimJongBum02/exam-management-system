<UserControl x:Class="ProfessorUI.View.FileReadyandDistributeView.FileReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.View.FileReadyandDistributeView"
             mc:Ignorable="d">
    <Grid>
        <Border BorderBrush="#5C6AC4" BorderThickness="1" CornerRadius="12" Background="White" Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,16">
                        <Border HorizontalAlignment="Left" Width="36" Height="36" CornerRadius="18" Background="#5C6AC4">
                            <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                    </Grid>

                    <TextBlock Text="파일 준비 및 암호화" FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,8"/>
                    <TextBlock Text="배포할 파일들을 선택하면, 자동으로 암호화 및 압축을 진행합니다." FontSize="14" Foreground="#64748B" Margin="0,0,0,24"/>

                    <TextBlock Text="원본 대상 파일" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding SelectedFilesSummary, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" FontSize="14" Foreground="#334155" Padding="12,8" Height="36" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <Button Grid.Column="1" Command="{Binding SelectFilesCommand}" Width="48" Height="36" Margin="8,0,0,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <Path Data="M4 4h6l2 2h8v12H4z" Fill="Transparent" Stroke="#475569" StrokeThickness="2" Width="20" Height="16" Stretch="Fill"/>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SelectedFileNames}" Margin="0,0,0,20" MaxHeight="80">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#94A3B8" Margin="4,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentStatusMessage}" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="Bold" Foreground="#5C6AC4" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressValue}" Height="8" Background="#E2E8F0" Foreground="#5C6AC4" BorderThickness="0" Margin="0,0,0,12">
                                <ProgressBar.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                            <TextBlock Text="{Binding CurrentFileNameDisplay}" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Row="1" Command="{Binding StartProcessCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="Background" Value="#5C6AC4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#5C6AC4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#4A58B2"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D499A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    압축 및 암호화 시작
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>