<UserControl x:Class="ProfessorUI.View.FileReadyandDistributeView.FileDistributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.View.FileReadyandDistributeView"
             mc:Ignorable="d">
    <Grid>
        <Border BorderBrush="#5C6AC4" BorderThickness="1" CornerRadius="12" Background="White" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,16">
                        <Border HorizontalAlignment="Left" Width="36" Height="36" CornerRadius="18" Background="#5C6AC4">
                            <TextBlock Text="2" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                       
                    </Grid>

                    <TextBlock Text="시험 파일 개별/일괄 배포" FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,8"/>
                    <TextBlock Text="준비된 암호화 파일을 선택한 학생의 PC로 전송합니다." FontSize="14" Foreground="#64748B" Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding DeployStatusMessage}" FontSize="16" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="학생 배포 목록" FontSize="14" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Command="{Binding SelectAllCommand}" Content="전체 선택" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding DeselectAllCommand}" Content="전체 해제" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Expander Header="목록 펼치기/접기" IsExpanded="True" Foreground="#64748B" FontSize="12" Margin="0,0,0,16">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Students}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <ProgressBar Grid.Column="2" Value="{Binding ProgressValue}" Maximum="100" Height="8" Background="#E2E8F0" Foreground="#5C6AC4" BorderThickness="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ProgressBar.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </ProgressBar.Resources>
                                                </ProgressBar>

                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16" Height="20"/>
                </StackPanel>

                <Button Grid.Row="1" Command="{Binding StartDeployCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="Background" Value="#5A6BC4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#5A6BC4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#4A58B2"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D499A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    선택 학생 파일 배포 시작
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>