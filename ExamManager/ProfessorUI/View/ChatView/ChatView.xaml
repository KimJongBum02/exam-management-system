<UserControl x:Class="ProfessorUI.View.ChatView.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext.ChatVM, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="💬 채팅방" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>

          
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10">
            <TextBlock Text="채팅 내역이 없습니다." Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"/>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Background="#F1F5F9" BorderThickness="0" Padding="10" VerticalContentAlignment="Center" Text="메시지 입력..."/>
                <Button Grid.Column="1" Content="전송" Background="#1A56DB" Foreground="White" Width="60" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>