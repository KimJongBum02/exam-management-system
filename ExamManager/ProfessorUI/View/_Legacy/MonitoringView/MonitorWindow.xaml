<Window x:Class="ProfessorUI.View.MonitoringView.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dashboard="clr-namespace:ProfessorUI.View.DashBoardCardView"
        xmlns:current="clr-namespace:ProfessorUI.View.CurrentTimeView"
        Title="시험 현황 모니터링" Width="1300" Height="800"
        FontFamily="{StaticResource AppFont}">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="AUTO" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="20">
            <Viewbox Stretch="Uniform" MaxHeight="500">
                <dashboard:DashBoardCardView DataContext="{Binding DashBoardCardVM}" />
            </Viewbox>
        </Border>

        <Border Grid.Row="1" Margin="20" HorizontalAlignment="Center">
            <Viewbox Stretch="Uniform" Height="500">
                <current:CurrentTimeView DataContext="{Binding CurrentTimeVM}" />
            </Viewbox>
        </Border>
    </Grid>
</Window>