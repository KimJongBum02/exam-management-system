<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>



  <ItemGroup>
    <Compile Include="..\NetworkInterop\NetworkInterop.cs" Link="NetworkInterop.cs" />
  </ItemGroup>

  <!-- 두 UI가 공유하는 글꼴 (ExamManager\Fonts) -->
  <ItemGroup>
    <Resource Include="..\Fonts\NEXON Lv2 Gothic.ttf" Link="Fonts\NEXON Lv2 Gothic.ttf" />
    <Resource Include="..\Fonts\NEXON Lv2 Gothic Bold.ttf" Link="Fonts\NEXON Lv2 Gothic Bold.ttf" />
  </ItemGroup>

  <!-- NetworkLib_Native.dll 자동 복사 (Debug/Release 구성에 맞게 자동 선택) -->
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll" Condition="Exists('$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NetworkLib_Native.dll</Link>
    </None>
    <None Include="$(SolutionDir)x64\$(Configuration)\FileControl.dll" Condition="Exists('$(SolutionDir)x64\$(Configuration)\FileControl.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FileControl.dll</Link>
    </None>
    <None Include="$(SolutionDir)7za.exe" Condition="Exists('$(SolutionDir)7za.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>7za.exe</Link>
    </None>
  </ItemGroup>

</Project>
