<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- 작업표시줄·탐색기에 보이는 아이콘. 두 UI 가 함께 쓰도록 글꼴과 같은 자리에 둔다 -->
    <ApplicationIcon>..\Assets\YUHAN.ico</ApplicationIcon>
  </PropertyGroup>



  <ItemGroup>
    <Compile Include="..\NetworkInterop\NetworkInterop.cs" Link="NetworkInterop.cs" />
    <!-- 학생 PC 와 같은 방식으로 설치 프로그램을 읽고, 같은 프로그램 사전을 쓰도록 한 벌을 나눠 쓴다 -->
    <Compile Include="..\Shared\StartMenuPrograms.cs" Link="StartMenuPrograms.cs" />
    <Compile Include="..\Shared\KnownPrograms.cs" Link="KnownPrograms.cs" />
    <!-- 경고·채팅이 왔을 때 깜빡임과 작업표시줄 알림 -->
    <Compile Include="..\Shared\UiSignal.cs" Link="UiSignal.cs" />
    <!-- 모든 창의 기본 글꼴 -->
    <Compile Include="..\Shared\UiFont.cs" Link="UiFont.cs" />
    <!-- 주 창 크기(최대화로 시작, 복원 1180×720) -->
    <Compile Include="..\Shared\UiWindow.cs" Link="UiWindow.cs" />
    <!-- 상단바 배치(왼쪽 제목 · 가운데 중요 공지 · 오른쪽 메뉴) -->
    <Compile Include="..\Shared\HeaderBarPanel.cs" Link="HeaderBarPanel.cs" />
  </ItemGroup>

  <!-- 두 UI가 공유하는 글꼴 (ExamManager\Fonts) -->
  <ItemGroup>
    <Resource Include="..\Fonts\Pretendard-Regular.ttf" Link="Fonts\Pretendard-Regular.ttf" />
    <Resource Include="..\Fonts\Pretendard-Bold.ttf" Link="Fonts\Pretendard-Bold.ttf" />
    <!-- 창 아이콘으로도 쓰려면 리소스로 들어가 있어야 한다 -->
    <Resource Include="..\Assets\YUHAN.ico" Link="Assets\YUHAN.ico" />
  </ItemGroup>

  <!-- NetworkLib_Native.dll 자동 복사 (Debug/Release 구성에 맞게 자동 선택) -->
  <ItemGroup>
    <None Include="$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll" Condition="Exists('$(SolutionDir)x64\$(Configuration)\NetworkLib_Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>NetworkLib_Native.dll</Link>
    </None>
    <None Include="$(SolutionDir)x64\$(Configuration)\FileControl.dll" Condition="Exists('$(SolutionDir)x64\$(Configuration)\FileControl.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FileControl.dll</Link>
    </None>
    <None Include="$(SolutionDir)7za.exe" Condition="Exists('$(SolutionDir)7za.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>7za.exe</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
