<Application x:Class="ProfessorUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProfessorUI"
             xmlns:status="clr-namespace:ProfessorUI.View.StudentStatusView"
             xmlns:files="clr-namespace:ProfessorUI.View.FileReadyandDistributeView"
             xmlns:exam="clr-namespace:ProfessorUI.View.ExamView"
             xmlns:flow="clr-namespace:ProfessorUI.View.ExamFlowView"
             xmlns:program="clr-namespace:ProfessorUI.View.ProgramControlView"
             xmlns:attendance="clr-namespace:ProfessorUI.View.AttenandceView"
             xmlns:viewmodels="clr-namespace:ProfessorUI.ViewModel"
             xmlns:quiz="clr-namespace:ProfessorUI.View.QuizView"
             >
    <Application.Resources>
        <!-- 앱 전체 기본 글꼴 — 글꼴을 바꿀 때는 이 줄과 csproj의 Resource 항목만 수정하면 된다 -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#NEXON Lv2 Gothic</FontFamily>

        <!-- ViewModel과 View 매핑 -->
        <DataTemplate DataType="{x:Type viewmodels:StudentBoardViewModel}">
            <status:StudentStatusView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:AttendanceMainViewModel}">
            <attendance:StudentListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:OXQuizViewModel}">
            <quiz:OXQuizView/>
        </DataTemplate>

        <!-- '시험' 메뉴 — 단계 마법사 본체 -->
        <DataTemplate DataType="{x:Type viewmodels:ExamFlowViewModel}">
            <flow:ExamFlowView />
        </DataTemplate>

        <!-- 시험 단계 1~7의 본문 화면.
             ExamFlowView의 ContentControl이 현재 단계의 뷰모델을 받으면
             아래 매핑을 보고 해당 View로 바꿔 그린다. -->
        <DataTemplate DataType="{x:Type viewmodels:ExamReadyStateViewModel}">
            <files:ExamReadyStateView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ProgramControlMainViewModel}">
            <program:ProgramControlMainView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:FileReadyViewModel}">
            <files:FileReadyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:FileDistributeViewModel}">
            <files:FileDistributeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ExamStartViewModel}">
            <exam:ExamStartView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:AnswerCollectViewModel}">
            <exam:AnswerCollectView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ExamEndViewModel}">
            <exam:ExamEndView />
        </DataTemplate>
    </Application.Resources>
</Application>
