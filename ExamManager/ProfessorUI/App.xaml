<Application x:Class="ProfessorUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProfessorUI"
             xmlns:views="clr-namespace:ProfessorUI.Views.StudentStatusView"
             xmlns:viewmodels="clr-namespace:ProfessorUI.ViewModels"
             >
    <Application.Resources>
        <!-- ViewModel과 View 매핑 -->
        <DataTemplate DataType="{x:Type viewmodels:StudentBoardViewModel}">
            <views:StudentStatusView />
        </DataTemplate>

        <!--<DataTemplate DataType="{x:Type viewmodels:FileReadyViewModel}">
            <views:FileReadyView />
        </DataTemplate>-->

        <!-- 나머지 ViewModel-View 매핑도 동일하게 추가 -->
    </Application.Resources>
</Application>
