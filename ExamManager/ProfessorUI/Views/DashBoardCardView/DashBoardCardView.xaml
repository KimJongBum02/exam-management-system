<UserControl x:Class="ProfessorUI.Views.DashBoardCardView.DashBoardCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.DashBoardCardView"
             mc:Ignorable="d" 
             Height="90" Width="649">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" CornerRadius="12" BorderThickness="2" Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="15" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="총 학생" Foreground="#64748B" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Text="20" Foreground="#1E293B" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" CornerRadius="12" BorderThickness="2" Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="15" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="접속" Foreground="#64748B" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Text="18" Foreground="#2563EB" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0" CornerRadius="12" BorderThickness="2" Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="15" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="진행 중" Foreground="#64748B" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Text="0" Foreground="#059669" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" CornerRadius="12" BorderThickness="2" Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#F05252" Opacity="0.1" BlurRadius="15" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="부정행위" Foreground="#64748B" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Text="0" Foreground="#DC2626" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>