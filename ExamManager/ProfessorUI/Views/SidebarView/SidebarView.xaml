<UserControl x:Class="ProfessorUI.Views.SidebarView.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.SidebarView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 상단 여백 및 타이틀 -->
                <RowDefinition Height="*" />
                <!-- 메뉴 리스트 -->
            </Grid.RowDefinitions>

            <!-- 1. 상단 '메뉴' 텍스트 -->
            <TextBlock Grid.Row="0" Text="메뉴" Foreground="#94A3B8" FontSize="13" Margin="26,30,0,16" />

            <!-- 2. 메뉴 리스트 (ListBox 활용) -->
            <ListBox x:Name="MenuListBox" 
                 SelectedIndex="{Binding SelectedIndex}" 
                 Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- ⭐ 리스트 안의 각 아이템(메뉴 버튼) 스타일 정의 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <!-- 선택 안 된 기본 글씨 색 (회색) -->
                        <Setter Property="Height" Value="52"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- 둥근 모서리(CornerRadius)를 가진 배경판 -->
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 마우스를 올렸을 때 (Hover) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <!-- 클릭해서 선택되었을 때 (Selected) -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A56DB"/>
                                            <!-- 쨍한 파란색 -->
                                            <Setter Property="Foreground" Value="White"/>
                                            <!-- 글씨와 아이콘을 하얗게 -->
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- ============================================== -->
                <!-- 3. 실제 메뉴 항목들 -->
                <!-- ============================================== -->

                <!-- 현황판 (기본 선택 상태로 두려면 IsSelected="True" 추가) -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="현황판" FontSize="16" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- 파일 배포 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="파일 배포" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- 시험 시작/종료 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="시험 시작/종료" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- 프로세스 제어 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="프로세스 제어" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- 출결 관리 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="출결 관리" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- OX 퀴즈 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OX 퀴즈" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>

            </ListBox>
        </Grid>
    </Border>
</UserControl>