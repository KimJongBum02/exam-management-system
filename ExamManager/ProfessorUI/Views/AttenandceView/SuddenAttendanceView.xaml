<UserControl x:Class="ProfessorUI.Views.AttenandceView.SuddenAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.AttenandceView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel>
            <!-- 제목 및 설명 -->
            <TextBlock Text="🔔 돌발 출석 체크" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="학생 PC에 팝업을 전송하여 즉각 응답을 수집합니다." Foreground="#777777" Margin="0,5,0,15"/>

            <!-- 전송 버튼 -->
            <Button Background="#F59E0B" Foreground="White" Padding="10" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="🔔 돌발 출석 체크 전송" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
