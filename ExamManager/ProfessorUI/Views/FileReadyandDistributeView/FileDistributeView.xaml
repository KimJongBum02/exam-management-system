<UserControl x:Class="ProfessorUI.Views.FileReadyandDistributeView.FileDistributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.FileReadyandDistributeView"
             mc:Ignorable="d" 
             >
    <Grid>
        <Border BorderBrush="#5C6AC4" BorderThickness="2" CornerRadius="16" Background="White" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,24">
                        <Border HorizontalAlignment="Left" Width="44" Height="44" CornerRadius="22" Background="#5C6AC4">
                            <TextBlock Text="2" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EEF2FF" CornerRadius="16" Padding="16,8">
                            <TextBlock Text="대기 중" Foreground="#4F46E5" FontSize="14" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="시험 파일 일괄 배포" FontSize="32" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,0,0,16"/>
                    <TextBlock Text="준비된 암호화 파일을 전체 접속 학생 PC로 동시에 전송합니다." FontSize="18" Foreground="#64748B" Margin="0,0,0,24"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="👥 배포 대상: 총 20명 (접속 20명 / 미접속 0명)" FontSize="18" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{Binding DeployStatusMessage}" FontSize="18" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding DeployProgressText}" FontSize="18" FontWeight="Bold" Foreground="#5C6AC4" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding DeployProgressValue}" Maximum="20" Height="12" Background="#E2E8F0" Foreground="#5C6AC4" BorderThickness="0">
                                <ProgressBar.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16" Height="20"/>
                </StackPanel>

                <Button Grid.Row="1" Command="{Binding StartDeployCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="54"/>
                            <Setter Property="Background" Value="#5A6BC4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#5A6BC4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0,16"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#4A58B2"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D499A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                    파일 일괄 배포 시작
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>