<UserControl x:Class="ProfessorUI.Views.TopMainView.TopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.TopMainView"
             xmlns:dash="clr-namespace:ProfessorUI.Views.DashBoardCardView"
             xmlns:timer="clr-namespace:ProfessorUI.Views.CurrentTimeView"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <dash:DashBoardCardView/>
            </Grid>
            <Grid Grid.Column="1">
                <timer:CurrentTimeView/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
