<UserControl x:Class="ProfessorUI.Views.ExamView.ExamEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProfessorUI.Views.ExamView"
             mc:Ignorable="d" 
   Background="Transparent">
    <Border BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="16" Background="#F8FAFC" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid Margin="0,0,0,20">
                    <Border HorizontalAlignment="Left" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9">
                        <TextBlock Text="3" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="12,6">
                        <TextBlock Text="대기 중" Foreground="#94A3B8" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Border Width="60" Height="60" Background="#F1F5F9" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,24">
                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="24" Height="24"/>
                </Border>

                <TextBlock Text="승인 후 종료" FontSize="28" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,12"/>
                <TextBlock Text="실습 폴더 삭제 후 PC를 자동 종료합니다." FontSize="16" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,30"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="#94A3B8" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="답안 수집 후 활성화" Foreground="#94A3B8" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
